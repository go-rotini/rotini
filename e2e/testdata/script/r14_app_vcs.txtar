	}
}
-- vcs_run.go.txt --
package vcs

import (
	"context"
	"fmt"
	"maps"
	"slices"

	"github.com/go-rotini/rotini"
)

var _ rotini.Handler = (*vcsRunHandler)(nil)

type vcsRunHandler struct {
	rotini.NoCascadingPreRun
	rotini.NoPreRun
	rotini.NoPostRun
	rotini.NoCascadingPostRun
}

func (*vcsRunHandler) Run(ctx context.Context, rtx *rotini.Context) {
	inputs, err := rtx.Inputs[VcsRunInputs]()
	if err != nil {
		rtx.HaltWith(err)
		return
	}
	a := inputs.VcsRun.Arguments
	dash, _ := rtx.DashIndex()
	env := inputs.VcsRun.Flags.Env
	for _, k := range slices.Sorted(maps.Keys(env)) {
		fmt.Fprintf(rtx.Stdout, "env %s=%s\n", k, env[k])
	}
	fmt.Fprintf(rtx.Stdout, "program=%q args=%q dash=%d\n", a.Program, a.Args, dash)
}
