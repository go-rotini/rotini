# R5 — the JSON-RPC shape, driven by real framed bytes on a real pipe.
#
# stdio_test.go covers the server in-process. The campaign asks for a real client because the
# two framings are a WIRE format: a Content-Length that disagrees with the body, a notification
# that must produce no reply at all, an error object's code — none of that is visible from a Go
# test that hands the server a buffer.

gomodinit example.com/rpc

exec rotini generate cmd/rpc/.rotini.spec.yaml --config cmd/rpc/.rotini.conf.yaml
exec go mod tidy
exec go build -o rpc$exe ./cmd/rpc

# Line framing: one JSON object per line, one reply per request.
stdin line-requests.txt
exec ./rpc$exe
stdout '"result":\{"echo":"hello"\}'

# A NOTIFICATION (no id) must produce no reply. A server that answered one would break every
# client that is not waiting for it.
stdin line-notification.txt
exec ./rpc$exe
! stdout '"id"'

# An unknown method is a JSON-RPC error object with the standard code, not a crash.
stdin line-unknown.txt
exec ./rpc$exe
stdout '"code":-32601'

# A handler's own RPCError carries its code and message through to the peer.
stdin line-apierror.txt
exec ./rpc$exe
stdout '"code":-32602'
stdout 'needs a name'

-- line-requests.txt --
{"jsonrpc":"2.0","id":1,"method":"echo","params":{"name":"hello"}}
-- line-notification.txt --
{"jsonrpc":"2.0","method":"ping"}
-- line-unknown.txt --
{"jsonrpc":"2.0","id":2,"method":"nosuchmethod"}
-- line-apierror.txt --
{"jsonrpc":"2.0","id":3,"method":"echo","params":{}}
-- cmd/rpc/.rotini.spec.yaml --
version: 1.2.3
command:
  name: rpc
  summary: a JSON-RPC server over stdio
-- cmd/rpc/.rotini.conf.yaml --
version: 1.2.3
generate:
  packages:
    - type: cmd
      file: internal/cmd/rpc/zz_rpc.go
      package: rpc
-- internal/cmd/rpc/rpc.go --
package rpc

import (
	"context"

	"github.com/go-rotini/rotini"
)

type rpcHandlers struct {
	rotini.DefaultCascadingPreRun
	rotini.DefaultPreRun
	rotini.DefaultPostRun
	rotini.DefaultCascadingPostRun
}

func (*rpcHandlers) Run(ctx context.Context, rtx *rotini.Context) {}
-- cmd/rpc/main.go --
package main

import (
	"context"
	"encoding/json"
	"os"

	"github.com/go-rotini/rotini"
)

// The StdioServer shape: the CLI a tool drives instead of a human.
func main() {
	srv := rotini.NewStdioServer(os.Stdin, os.Stdout).
		WithFraming(rotini.FramingLine).
		Handle("echo", func(ctx context.Context, params json.RawMessage) (any, error) {
			var in struct {
				Name string `json:"name"`
			}
			if len(params) > 0 {
				if err := json.Unmarshal(params, &in); err != nil {
					return nil, rotini.NewRPCError(rotini.CodeInvalidParams, err.Error())
				}
			}
			if in.Name == "" {
				return nil, rotini.NewRPCError(rotini.CodeInvalidParams, "echo needs a name")
			}
			return map[string]string{"echo": in.Name}, nil
		}).
		Notify("ping", func(ctx context.Context, params json.RawMessage) error { return nil })

	if err := srv.Run(context.Background()); err != nil {
		os.Exit(1)
	}
}
