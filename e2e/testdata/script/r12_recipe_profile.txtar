# R12 — the profiling recipe: hidden --cpuprofile and --trace flags start the profiler and the
# tracer in the root's CascadingPreRun and stop them in its CascadingPostRun, which runs after
# a failed command too. The root handler file is the one the guide shows.

gomodinit example.com/profdemo

exec rotini generate cmd/profdemo/.rotini.spec.yaml --config cmd/profdemo/.rotini.conf.yaml
cp root.go.txt internal/cmd/profdemo/profdemo.go
cp work.go.txt internal/cmd/profdemo/profdemo_work.go
exec go mod tidy
exec go build -o profdemo$exe ./cmd/profdemo

exec ./profdemo$exe work --cpuprofile cpu.prof --trace trace.out
stdout '^worked$'
exists cpu.prof
exists trace.out
exec go tool pprof -top profdemo$exe cpu.prof
stdout 'Type: cpu'

# A failed command still writes its profile.
rm cpu.prof
wantexit 1 ./profdemo$exe work --fail --cpuprofile cpu.prof
exists cpu.prof

# The flags are hidden from help.
exec ./profdemo$exe --help
! stdout cpuprofile

-- root.go.txt --
package profdemo

import (
	"context"
	"fmt"
	"os"
	"path/filepath"
	"runtime/pprof"
	"runtime/trace"

	"github.com/go-rotini/rotini"
)

var _ rotini.ErrorHandler = (*profdemoHandler)(nil)

type profdemoHandler struct {
	rotini.NoPreRunE
	rotini.NoPostRunE

	// The files stay open from CascadingPreRun until CascadingPostRun closes them.
	cpu, trace *os.File
}

func (h *profdemoHandler) CascadingPreRun(ctx context.Context, rtx *rotini.Context) error {
	inputs, err := rtx.Inputs[ProfdemoInputs]()
	if err != nil {
		return err
	}
	flags := inputs.Profdemo.Flags
	if flags.Help {
		fmt.Fprintln(rtx.Stdout, rtx.Help())
		rtx.HaltWithCode(0)
		return nil
	}
	if flags.Cpuprofile != "" {
		if h.cpu, err = os.Create(filepath.Join(rtx.Dir(), flags.Cpuprofile)); err != nil {
			return err
		}
		if err := pprof.StartCPUProfile(h.cpu); err != nil {
			return err
		}
	}
	if flags.Trace != "" {
		if h.trace, err = os.Create(filepath.Join(rtx.Dir(), flags.Trace)); err != nil {
			return err
		}
		if err := trace.Start(h.trace); err != nil {
			return err
		}
	}

	return nil
}

// CascadingPostRun runs after the command, even when it failed or panicked, so the profile
// and the trace are always complete.
func (h *profdemoHandler) CascadingPostRun(ctx context.Context, rtx *rotini.Context) error {
	if h.cpu != nil {
		pprof.StopCPUProfile()
		if err := h.cpu.Close(); err != nil {
			rtx.RecordError(err)
		}
	}
	if h.trace != nil {
		trace.Stop()
		if err := h.trace.Close(); err != nil {
			rtx.RecordError(err)
		}
	}

	return nil
}

func (*profdemoHandler) Run(ctx context.Context, rtx *rotini.Context) error {
	fmt.Fprintln(rtx.Stderr, rtx.Help())
	rtx.HaltWithCode(1)
	return nil
}
-- work.go.txt --
package profdemo

import (
	"context"
	"errors"
	"fmt"

	"github.com/go-rotini/rotini"
)

var _ rotini.ErrorHandler = (*profdemoWorkHandler)(nil)

type profdemoWorkHandler struct {
	rotini.NoCascadingPreRunE
	rotini.NoPreRunE
	rotini.NoPostRunE
	rotini.NoCascadingPostRunE
}

func (*profdemoWorkHandler) Run(ctx context.Context, rtx *rotini.Context) error {
	inputs, err := rtx.Inputs[ProfdemoWorkInputs]()
	if err != nil {
		return err
	}
	n := 0
	for i := range 20_000_000 {
		n += i % 7
	}
	if inputs.ProfdemoWork.Flags.Fail {
		return errors.New("failed on purpose")
	}
	fmt.Fprintln(rtx.Stdout, "worked")
	return nil
}
-- cmd/profdemo/.rotini.spec.yaml --
version: 0.0.0
command:
  name: profdemo
  summary: profile any command
  flags:
    - name: help
      summary: print help
      identifiers: [-h, --help]
      cascading: true
      short_circuit: true
      schema: { type: bool }
    - name: cpuprofile
      summary: write a CPU profile to this file
      identifiers: [--cpuprofile]
      cascading: true
      hidden: true
      schema: { type: string }
    - name: trace
      summary: write an execution trace to this file
      identifiers: [--trace]
      cascading: true
      hidden: true
      schema: { type: string }
  commands:
    - name: work
      summary: do some work
      flags:
        - name: fail
          summary: fail after the work
          identifiers: [--fail]
          schema: { type: bool }
-- cmd/profdemo/.rotini.conf.yaml --
version: 0.0.0
generate:
  packages:
    - type: main
      file: cmd/profdemo/main.go
      package: main
    - type: cmd
      file: internal/cmd/profdemo/zz_profdemo.go
      package: profdemo
      hook_returns: error
  features:
    - type: help
      enabled: true
