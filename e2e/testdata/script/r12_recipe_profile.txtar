# R12 — the profiling recipe: a middleware starts the profiler and the tracer that hidden
# --cpuprofile and --trace flags ask for before the root's CascadingPreRun, and stops them after
# its CascadingPostRun, which runs after a failed command too. The root handler stays the seeded
# one. The middleware and main.go are the ones the guide shows.

gomodinit example.com/profdemo

exec rotini generate cmd/profdemo/.rotini.spec.yaml --config cmd/profdemo/.rotini.conf.yaml
cp profile.go.txt internal/cmd/profdemo/profile.go
cp main.go.txt cmd/profdemo/main.go
cp work.go.txt internal/cmd/profdemo/profdemo_work.go
exec go mod tidy
exec go build -o profdemo$exe ./cmd/profdemo

exec ./profdemo$exe work --cpuprofile cpu.prof --trace trace.out
stdout '^worked$'
exists cpu.prof
exists trace.out
exec go tool pprof -top profdemo$exe cpu.prof
stdout 'Type: cpu'

# A failed command still writes its profile.
rm cpu.prof
wantexit 1 ./profdemo$exe work --fail --cpuprofile cpu.prof
exists cpu.prof
exec go tool pprof -top profdemo$exe cpu.prof
stdout 'Type: cpu'

# Without the flags nothing is written.
rm cpu.prof
exec ./profdemo$exe work
! exists cpu.prof

# A file that can't be created fails the run before the command does any work.
wantexit 1 ./profdemo$exe work --cpuprofile missing/cpu.prof
stderr '^Error: open .*cpu\.prof: '
! stdout worked

# The flags are hidden from help.
exec ./profdemo$exe --help
! stdout cpuprofile

-- profile.go.txt --
package profdemo

import (
	"context"
	"os"
	"path/filepath"
	"runtime/pprof"
	"runtime/trace"

	"github.com/go-rotini/rotini"
)

// profiles holds the files a run's profiles are written to.
type profiles struct{ cpu, trace *os.File }

// running is this run's profiles, kept from the root's CascadingPreRun to its
// CascadingPostRun.
var running = rotini.NewDependency[*profiles]("profdemo.profiles")

// Profile starts what --cpuprofile and --trace ask for before the root's CascadingPreRun, the
// first hook of every run, and stops it after the root's CascadingPostRun, the last, which runs
// even when the command failed or panicked.
func Profile(h rotini.Hook, next rotini.HookFunc) rotini.HookFunc {
	// The root is the command no word on the command line named.
	if h.Command.Matched != "" {
		return next
	}
	switch h.Kind {
	case rotini.HookCascadingPreRun:
		return func(ctx context.Context, rtx *rotini.Context) error {
			if err := start(rtx); err != nil {
				return err
			}
			return next(ctx, rtx)
		}
	case rotini.HookCascadingPostRun:
		return func(ctx context.Context, rtx *rotini.Context) error {
			err := next(ctx, rtx)
			if p, ok := rtx.LookupDependency(running); ok {
				p.stop(rtx)
			}
			return err
		}
	}
	return next
}

func start(rtx *rotini.Context) error {
	inputs, err := rtx.Inputs[ProfdemoInputs]()
	if err != nil {
		return err
	}
	flags := inputs.Profdemo.Flags
	p := new(profiles)
	rtx.SetDependency(running, p)
	if flags.Cpuprofile != "" {
		if p.cpu, err = os.Create(filepath.Join(rtx.Dir(), flags.Cpuprofile)); err != nil {
			return err
		}
		if err := pprof.StartCPUProfile(p.cpu); err != nil {
			return err
		}
	}
	if flags.Trace != "" {
		if p.trace, err = os.Create(filepath.Join(rtx.Dir(), flags.Trace)); err != nil {
			return err
		}
		if err := trace.Start(p.trace); err != nil {
			return err
		}
	}
	return nil
}

func (p *profiles) stop(rtx *rotini.Context) {
	if p.cpu != nil {
		pprof.StopCPUProfile()
		if err := p.cpu.Close(); err != nil {
			rtx.RecordError(err)
		}
	}
	if p.trace != nil {
		trace.Stop()
		if err := p.trace.Close(); err != nil {
			rtx.RecordError(err)
		}
	}
}
-- main.go.txt --
//go:generate go tool rotini generate ./.rotini.spec.yaml --config ./.rotini.conf.yaml
package main

import (
	cmd "example.com/profdemo/internal/cmd/profdemo"
)

func main() {
	cmd.NewProgram().
		WithMiddleware(cmd.Profile).
		Execute()
}
-- work.go.txt --
package profdemo

import (
	"context"
	"errors"
	"fmt"

	"github.com/go-rotini/rotini"
)

var _ rotini.HandlerE = (*profdemoWorkHandler)(nil)

type profdemoWorkHandler struct {
	rotini.NoCascadingPreRunE
	rotini.NoPreRunE
	rotini.NoPostRunE
	rotini.NoCascadingPostRunE
}

func (*profdemoWorkHandler) Run(ctx context.Context, rtx *rotini.Context) error {
	inputs, err := rtx.Inputs[ProfdemoWorkInputs]()
	if err != nil {
		return err
	}
	n := 0
	for i := range 20_000_000 {
		n += i % 7
	}
	if inputs.ProfdemoWork.Flags.Fail {
		return errors.New("failed on purpose")
	}
	fmt.Fprintln(rtx.Stdout, "worked")
	return nil
}
-- cmd/profdemo/.rotini.spec.yaml --
version: 0.0.0
command:
  name: profdemo
  summary: profile any command
  flags:
    - name: help
      summary: print help
      identifiers: [-h, --help]
      cascading: true
      short_circuit: true
      schema: { type: bool }
    - name: cpuprofile
      summary: write a CPU profile to this file
      identifiers: [--cpuprofile]
      cascading: true
      hidden: true
      schema: { type: string }
    - name: trace
      summary: write an execution trace to this file
      identifiers: [--trace]
      cascading: true
      hidden: true
      schema: { type: string }
  commands:
    - name: work
      summary: do some work
      flags:
        - name: fail
          summary: fail after the work
          identifiers: [--fail]
          schema: { type: bool }
-- cmd/profdemo/.rotini.conf.yaml --
version: 0.0.0
generate:
  packages:
    - type: main
      file: cmd/profdemo/main.go
      package: main
    - type: cmd
      file: internal/cmd/profdemo/zz_profdemo.go
      package: profdemo
      hook_returns: error
  features:
    - type: help
      enabled: true
