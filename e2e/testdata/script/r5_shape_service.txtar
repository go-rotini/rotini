# R5 — the service/daemon shape, stopped by a REAL signal.
#
# service_test.go drives Service with a context it cancels itself. This proves the thing a
# daemon operator actually depends on: the binary's default SIGINT/SIGTERM trap cancels the
# run context, the Service built on that context stops its workers, and the shutdown hooks run
# in order — with a signal the kernel delivered, not a context a test canceled.
#
# The process signals itself so the assertion is deterministic; the signal path is identical.

[!unix] skip 'sends a real SIGTERM to its own process'

gomodinit example.com/daemon

exec rotini generate cmd/daemon/.rotini.spec.yaml --config cmd/daemon/.rotini.conf.yaml
exec go mod tidy
exec go build -o daemon$exe ./cmd/daemon

# 128+SIGTERM(15) = 143, the documented exit for a signal-terminated run. Asserting the exact
# code is the point: a shell script that wraps this daemon branches on it.
wantexit 143 ./daemon$exe serve

! exec ./daemon$exe serve
stdout 'worker started'
stdout 'worker stopped'

# Shutdown hooks run in REVERSE registration order, like deferred calls, so a resource is
# released before whatever it depends on. Declaring flush then close means close runs first.
stdout 'shutdown: close'
stdout 'shutdown: flush'

# A graceful stop is not a failure: the trap's exit is a deliberate one, and the funnel
# reports nothing because nothing was recorded.
! stderr 'Error'

-- cmd/daemon/.rotini.spec.yaml --
version: 0.0.0
command:
  name: daemon
  summary: a long-running service
  commands:
    - name: serve
      summary: run workers until interrupted
-- cmd/daemon/.rotini.conf.yaml --
version: 0.0.0
generate:
  packages:
    - type: cmd
      file: internal/cmd/daemon/zz_daemon.go
      package: daemon
-- internal/cmd/daemon/daemon.go --
package daemon

import (
	"context"

	"github.com/go-rotini/rotini"
)

type daemonHandlers struct {
	rotini.DefaultCascadingPreRun
	rotini.DefaultPreRun
	rotini.DefaultPostRun
	rotini.DefaultCascadingPostRun
}

func (*daemonHandlers) Run(ctx context.Context, rtx *rotini.Context) {}
-- internal/cmd/daemon/daemon_serve.go --
package daemon

import (
	"context"
	"fmt"
	"os"
	"syscall"
	"time"

	"github.com/go-rotini/rotini"
)

type daemonServeHandlers struct {
	rotini.DefaultCascadingPreRun
	rotini.DefaultPreRun
	rotini.DefaultPostRun
	rotini.DefaultCascadingPostRun
}

// Run is the daemon shape: the ctx the runtime hands a handler is already canceled by the
// default SIGINT/SIGTERM trap, so a Service built on it gets graceful shutdown for free.
func (*daemonServeHandlers) Run(ctx context.Context, rtx *rotini.Context) {
	// Deliver a real SIGTERM to this process shortly after the workers are up. An operator
	// sends it from outside; the path through the trap is the same either way.
	go func() {
		time.Sleep(150 * time.Millisecond)
		_ = syscall.Kill(os.Getpid(), syscall.SIGTERM)
	}()

	svc := rotini.NewService().
		Go("worker", func(ctx context.Context) error {
			fmt.Fprintln(rtx.Stdout, "worker started")
			<-ctx.Done()
			fmt.Fprintln(rtx.Stdout, "worker stopped")
			return nil
		}).
		WithShutdown(func(context.Context) error {
			fmt.Fprintln(rtx.Stdout, "shutdown: flush")
			return nil
		}).
		WithShutdown(func(context.Context) error {
			fmt.Fprintln(rtx.Stdout, "shutdown: close")
			return nil
		}).
		WithShutdownTimeout(5 * time.Second)

	if err := svc.Run(ctx); err != nil && !rotiniGracefulStop(err) {
		rtx.RecordError(err)
	}
}

// rotiniGracefulStop reports whether err is just the signal-cancellation that ended the run,
// which is a deliberate stop rather than a failure.
func rotiniGracefulStop(err error) bool {
	return err != nil && (err == context.Canceled || context.Cause(context.Background()) == err)
}
-- cmd/daemon/main.go --
package main

import (
	daemon "example.com/daemon/internal/cmd/daemon"
)

func main() {
	daemon.Program.
		Execute()
}
