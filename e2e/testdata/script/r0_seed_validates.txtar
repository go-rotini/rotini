# R0 — the seeded documents must pass rotini's own gate, with no warnings.
#
# A scaffold that does not validate teaches a new user that validation is noise. The seeded
# conf used to carry embed_dir/template_dir on features whose mode ignores them (audit F-12):
# four lines that did nothing, in the first rotini file anyone reads.

gomodinit example.com/demo

exec rotini init demo
cd cmd/demo

exec rotini validate .rotini.spec.yaml --config .rotini.conf.yaml
! stderr 'warning'
! stderr 'Error'

# Validation is also idempotent and side-effect free: running it twice changes nothing.
exec rotini validate .rotini.spec.yaml --config .rotini.conf.yaml
