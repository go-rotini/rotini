# R4 — the lifecycle, observed from a real three-deep tree.
#
# A tree that records every event it takes part in, so the whole transcript asserts the hook
# order the runtime picks. It also pins:
#
#   1. a cascading hook reading its own flags: Inputs anchors on rtx.Command(), the command
#      whose hook is running, so a root cascading hook reads the root's flags at any depth;
#
#   2. Context.Failed, which lets a teardown decide to commit or roll back before the
#      reporter sees the Outcome.

gomodinit example.com/life

exec rotini generate cmd/life/.rotini.spec.yaml --config cmd/life/.rotini.conf.yaml
exec go mod tidy
exec go build -o life$exe ./cmd/life

# ── order ────────────────────────────────────────────────────────────────────
# Cascading hooks bracket every ancestor; the non-cascading ones belong to the leaf alone.
# `work` is an ancestor of `run`, so its PreRun must not appear.
exec ./life$exe --verbose job work run
cmp stdout order.txt

# ── PreRun is the leaf's, and only the leaf's ────────────────────────────────
! stdout 'work PreRun'

# ── the root's cascading hook read its own flag ──────────────────────────────
# This is the frame-anchoring assertion. Without it the first line reads "root CascadingPreRun
# verbose=false" while --verbose sits in argv.
stdout 'root CascadingPreRun verbose=true'

# ── teardown runs after a failure, and Failed() drives the decision ──────────
! exec ./life$exe job work run --fail
stdout 'work CascadingPostRun ROLLBACK'
stdout 'root CascadingPostRun'
! stdout 'work CascadingPostRun commit'
stderr 'the work failed'

# A clean run commits instead.
exec ./life$exe job work run
stdout 'work CascadingPostRun commit'

# ── a panic unwinds too, and Failed() sees it ────────────────────────────────
# The case a program's own hand-kept "did we fail" flag would miss: the handler never runs to
# the line that would set it.
! exec ./life$exe job work run --panic
stdout 'work CascadingPostRun ROLLBACK'
stdout 'root CascadingPostRun'
stderr 'panic'

# ── collecting an ancestor's type from a deeper command is an error ──────────
# `--misaligned` makes the leaf do it deliberately.
! exec ./life$exe job work run --misaligned
stderr 'does not describe the running command "life job work run"'
stderr 'its Life field maps to "run"'
stderr 'cannot be collected from a deeper command'

-- order.txt --
root CascadingPreRun verbose=true
job CascadingPreRun
work CascadingPreRun begin
run PreRun
run Run
run PostRun
work CascadingPostRun commit
job CascadingPostRun
root CascadingPostRun
-- cmd/life/.rotini.spec.yaml --
version: 0.0.0
command:
  name: life
  summary: a tree that narrates its own lifecycle
  flags:
    - name: verbose
      summary: narrate
      identifiers: ["--verbose"]
      cascading: true
      schema: { type: bool }
  commands:
    - name: job
      summary: a middle command
      commands:
        - name: work
          summary: another middle command
          commands:
            - name: run
              summary: the leaf
              flags:
                - name: fail
                  summary: record an error
                  identifiers: ["--fail"]
                  schema: { type: bool }
                - name: panic
                  summary: panic
                  identifiers: ["--panic"]
                  schema: { type: bool }
                - name: misaligned
                  summary: collect an ancestor's inputs type on purpose
                  identifiers: ["--misaligned"]
                  schema: { type: bool }
-- cmd/life/.rotini.conf.yaml --
version: 0.0.0
generate:
  packages:
    - type: main
      file: cmd/life/main.go
    - type: cmd
      file: internal/cmd/life/zz_life.go
      package: life
-- internal/cmd/life/life.go --
package life

import (
	"context"
	"fmt"

	"github.com/go-rotini/rotini"
)

func say(rtx *rotini.Context, format string, args ...any) {
	fmt.Fprintf(rtx.Stdout, format+"\n", args...)
}

type lifeHandler struct {
	rotini.NoPreRun
	rotini.NoPostRun
}

func (*lifeHandler) CascadingPreRun(ctx context.Context, rtx *rotini.Context) {
	// Inputs anchors the struct on rtx.Command() — the command whose hook is running, which
	// here is the root rather than the leaf. So a cascading hook reads its OWN flags with the
	// same call a leaf's Run uses, without naming the leaf's type (which it cannot know).
	in, err := rtx.Inputs[LifeInputs]()
	if err != nil {
		rtx.RecordError(err)
		rtx.HaltWithCode(1)
		return
	}
	say(rtx, "root CascadingPreRun verbose=%t", in.Life.Flags.Verbose)
}

func (*lifeHandler) CascadingPostRun(ctx context.Context, rtx *rotini.Context) {
	say(rtx, "root CascadingPostRun")
}

func (*lifeHandler) Run(ctx context.Context, rtx *rotini.Context) {}
-- internal/cmd/life/life_job.go --
package life

import (
	"context"

	"github.com/go-rotini/rotini"
)

type lifeJobHandler struct {
	rotini.NoPreRun
	rotini.NoPostRun
}

func (*lifeJobHandler) CascadingPreRun(ctx context.Context, rtx *rotini.Context) {
	say(rtx, "job CascadingPreRun")
}

func (*lifeJobHandler) CascadingPostRun(ctx context.Context, rtx *rotini.Context) {
	say(rtx, "job CascadingPostRun")
}

func (*lifeJobHandler) Run(ctx context.Context, rtx *rotini.Context) {}
-- internal/cmd/life/life_job_work.go --
package life

import (
	"context"

	"github.com/go-rotini/rotini"
)

// lifeJobWorkHandler brackets its subtree the way a transaction does. A PreRun here would
// run for `work` alone — never when `run` is the leaf — so the bracket has to be cascading.
type lifeJobWorkHandler struct {
	rotini.NoPreRun
	rotini.NoPostRun
}

func (*lifeJobWorkHandler) CascadingPreRun(ctx context.Context, rtx *rotini.Context) {
	say(rtx, "work CascadingPreRun begin")
}

func (*lifeJobWorkHandler) CascadingPostRun(ctx context.Context, rtx *rotini.Context) {
	// The decision a teardown exists to make, and the only way to make it.
	if rtx.Failed() {
		say(rtx, "work CascadingPostRun ROLLBACK")
		return
	}
	say(rtx, "work CascadingPostRun commit")
}

func (*lifeJobWorkHandler) Run(ctx context.Context, rtx *rotini.Context) {}
-- internal/cmd/life/life_job_work_run.go --
package life

import (
	"context"
	"errors"

	"github.com/go-rotini/rotini"
)

type lifeJobWorkRunHandler struct {
	rotini.NoCascadingPreRun
	rotini.NoCascadingPostRun
}

func (*lifeJobWorkRunHandler) PreRun(ctx context.Context, rtx *rotini.Context) {
	say(rtx, "run PreRun")
}

func (*lifeJobWorkRunHandler) PostRun(ctx context.Context, rtx *rotini.Context) {
	say(rtx, "run PostRun")
}

func (*lifeJobWorkRunHandler) Run(ctx context.Context, rtx *rotini.Context) {
	in, err := rtx.Inputs[LifeJobWorkRunInputs]()
	if err != nil {
		rtx.RecordError(err)
		rtx.HaltWithCode(1)
		return
	}
	say(rtx, "run Run")

	f := in.LifeJobWorkRun.Flags
	switch {
	case f.Misaligned:
		// Deliberately wrong: LifeInputs describes `life`, and the running command is
		// `life job work run`. This used to bind zeros in silence.
		if _, err := rtx.Inputs[LifeInputs](); err != nil {
			rtx.RecordError(err)
			rtx.HaltWithCode(1)
		}
	case f.Panic:
		panic("run panicked")
	case f.Fail:
		rtx.RecordError(errors.New("the work failed"))
		rtx.HaltWithCode(1)
	}
}
-- cmd/life/main.go --
package main

import (
	life "example.com/life/internal/cmd/life"
)

func main() {
	life.Program.
		Execute()
}
