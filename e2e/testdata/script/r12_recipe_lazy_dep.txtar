# R12 — the lazy dependency recipe: a store provided with Program.WithProvider is opened only
# by a command that asks for it, once, never by --help, and a test's own registration wins.
# The files are the ones the guide shows.

gomodinit example.com/lazydemo

exec rotini generate cmd/lazydemo/.rotini.spec.yaml --config cmd/lazydemo/.rotini.conf.yaml
cp store.go.txt internal/cmd/lazydemo/store.go
cp get.go.txt internal/cmd/lazydemo/lazydemo_get.go
cp root.go.txt internal/cmd/lazydemo/lazydemo.go
cp main.go.txt cmd/lazydemo/main.go
exec go mod tidy
exec go build -o lazydemo$exe ./cmd/lazydemo

# hello never asks for the store, so it runs without one, and so does --help.
exec ./lazydemo$exe hello
stdout '^hello$'
exec ./lazydemo$exe --help
! stderr .
exec ./lazydemo$exe get --help
! stderr .

# get opens it, and fails when it can't.
wantexit 1 ./lazydemo$exe get region
stderr 'store.txt'

cp data.txt store.txt
exec ./lazydemo$exe get region
stdout '^eu-1$'

# A test's double, registered with Program.WithDependency, wins over the provider, so the real
# store is never opened.
cp double_test.go.txt internal/cmd/lazydemo/double_test.go
exec go test ./internal/cmd/lazydemo
stdout '^ok'

-- double_test.go.txt --
package lazydemo

import (
	"strings"
	"testing"
)

func TestGetUsesTheDouble(t *testing.T) {
	double := &Store{values: map[string]string{"region": "test-1"}}
	var out strings.Builder
	p := NewProgram().With(WithStore).WithDependency(storeDep, double).WithDir(t.TempDir()).WithStdout(&out)
	if code, err := p.Run([]string{"get", "region"}); code != 0 || err != nil {
		t.Fatalf("get: exit %d, %v", code, err)
	}
	if out.String() != "test-1\n" {
		t.Fatalf("get printed %q", out.String())
	}
}
-- data.txt --
region=eu-1
-- store.go.txt --
package lazydemo

import (
	"context"
	"os"
	"path/filepath"
	"strings"

	"github.com/go-rotini/rotini"
)

// Store is costly to open, so only the commands that use it open it.
type Store struct{ values map[string]string }

var storeDep = rotini.NewDependency[*Store]("lazydemo.store")

// WithStore, a rotini.Option, provides the store: a run opens it the first time a command
// asks for it, and a run that never asks never opens it.
func WithStore(p *rotini.Program) { p.WithProvider(storeDep, openStore) }

func openStore(ctx context.Context, rtx *rotini.Context) (*Store, func() error, error) {
	data, err := os.ReadFile(filepath.Join(rtx.Dir(), "store.txt"))
	if err != nil {
		return nil, nil, err
	}
	s := &Store{values: map[string]string{}}
	for line := range strings.Lines(string(data)) {
		if k, v, ok := strings.Cut(strings.TrimSpace(line), "="); ok {
			s.values[k] = v
		}
	}
	return s, nil, nil // the file is read and closed, so nothing is left to clean up
}
-- get.go.txt --
package lazydemo

import (
	"context"
	"fmt"

	"github.com/go-rotini/rotini"
)

var _ rotini.HandlerE = (*lazydemoGetHandler)(nil)

type lazydemoGetHandler struct {
	rotini.NoCascadingPreRunE
	rotini.NoPreRunE
	rotini.NoPostRunE
	rotini.NoCascadingPostRunE
}

func (*lazydemoGetHandler) Run(ctx context.Context, rtx *rotini.Context) error {
	inputs, err := rtx.Inputs[LazydemoGetInputs]()
	if err != nil {
		return err
	}
	store, err := rtx.Dependency(storeDep)
	if err != nil {
		return err
	}
	fmt.Fprintln(rtx.Stdout, store.values[inputs.LazydemoGet.Arguments.Key])
	return nil
}
-- main.go.txt --
package main

import (
	cmd "example.com/lazydemo/internal/cmd/lazydemo"
)

func main() {
	cmd.NewProgram().
		With(cmd.WithStore).
		Execute()
}
-- root.go.txt --
package lazydemo

import (
	"context"
	"fmt"

	"github.com/go-rotini/rotini"
)

var _ rotini.HandlerE = (*lazydemoHandler)(nil)

type lazydemoHandler struct {
	rotini.NoPreRunE
	rotini.NoPostRunE
	rotini.NoCascadingPostRunE
}

func (*lazydemoHandler) CascadingPreRun(ctx context.Context, rtx *rotini.Context) error {
	inputs, err := rtx.Inputs[LazydemoInputs]()
	if err != nil {
		return err
	}
	if inputs.Lazydemo.Flags.Help {
		fmt.Fprintln(rtx.Stdout, rtx.Help())
		rtx.HaltWithCode(0)
	}

	return nil
}

func (*lazydemoHandler) Run(ctx context.Context, rtx *rotini.Context) error {
	fmt.Fprintln(rtx.Stderr, rtx.Help())
	rtx.HaltWithCode(1)
	return nil
}
-- internal/cmd/lazydemo/lazydemo_hello.go --
package lazydemo

import (
	"context"
	"fmt"

	"github.com/go-rotini/rotini"
)

var _ rotini.HandlerE = (*lazydemoHelloHandler)(nil)

type lazydemoHelloHandler struct {
	rotini.NoCascadingPreRunE
	rotini.NoPreRunE
	rotini.NoPostRunE
	rotini.NoCascadingPostRunE
}

func (*lazydemoHelloHandler) Run(ctx context.Context, rtx *rotini.Context) error {
	fmt.Fprintln(rtx.Stdout, "hello")
	return nil
}
-- cmd/lazydemo/.rotini.spec.yaml --
version: 0.0.0
command:
  name: lazydemo
  summary: open the store only when a command needs it
  flags:
    - name: help
      summary: print help
      identifiers: [-h, --help]
      cascading: true
      short_circuit: true
      schema: { type: bool }
  commands:
    - name: get
      summary: print a value from the store
      arguments:
        - name: key
          summary: the key to read
          schema: { type: string, required: true }
    - name: hello
      summary: print a greeting, without the store
-- cmd/lazydemo/.rotini.conf.yaml --
version: 0.0.0
generate:
  packages:
    - type: main
      file: cmd/lazydemo/main.go
      package: main
    - type: cmd
      file: internal/cmd/lazydemo/zz_lazydemo.go
      package: lazydemo
      hook_returns: error
  features:
    - type: help
      enabled: true
