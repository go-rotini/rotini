# R2 — the declarative completion hint, over the real __complete wire.
#
# A `complete:` hint declares a value's shape ("this is a file") without a Go completer. It
# rides the last line of __complete's output as a directive each generated script translates
# into that shell's own path completion.

gomodinit example.com/hints

exec rotini generate cmd/hints/.rotini.spec.yaml --config cmd/hints/.rotini.conf.yaml
exec go mod tidy
exec go build -o hints$exe ./cmd/hints

# A file flag, narrowed to extensions.
exec ./hints$exe __complete --config ''
stdout '^:rotini:file yaml yml$'

# The inline form asks the same question.
exec ./hints$exe __complete '--config='
stdout '^:rotini:file yaml yml$'

# Directories only.
exec ./hints$exe __complete --out ''
stdout '^:rotini:directory$'

# An opaque value suppresses the shell's file fallback — which is not the same as
# declaring no hint, where the shell applies its own default.
exec ./hints$exe __complete --id ''
stdout '^:rotini:none$'

exec ./hints$exe __complete --plain ''
! stdout ':rotini:'

# A static enum still comes through as candidates, with the directive absent.
exec ./hints$exe __complete --format ''
stdout '^json$'
stdout '^yaml$'
! stdout ':rotini:'

# A positional's hint works the same way.
exec ./hints$exe __complete open ''
stdout '^:rotini:file$'

# A map key is completed up to its "=", with no space after it, and bash's split of the
# entry ("--set image = <TAB>") is the value, which offers nothing, not sub-commands.
exec ./hints$exe __complete --set ''
cmp stdout want-keys.txt
exec ./hints$exe __complete --set image = ''
cmp stdout want-none.txt

# The shell completes account names itself.
exec ./hints$exe __complete --owner ''
stdout '^:rotini:user$'

# help <TAB> completes command paths, and never files.
exec ./hints$exe __complete help ''
cmp stdout want-help.txt

# The generated scripts must actually handle the directive rather than offering it as a
# candidate — a user would otherwise be shown a line of punctuation.
exec rotini generate cmd/hints/.rotini.spec.yaml --config completion.conf.yaml
grep ':rotini:' internal/cmd/hints/renders/completion_bash.txt
grep ':rotini:' internal/cmd/hints/renders/completion_zsh.txt
grep ':rotini:' internal/cmd/hints/renders/completion_fish.txt
grep ':rotini:' internal/cmd/hints/renders/completion_powershell.txt

-- want-keys.txt --
image=
replicas=
:rotini:option nospace
-- want-none.txt --
:rotini:none
-- want-help.txt --
help	print help
open	open a file
:rotini:none
-- completion.conf.yaml --
version: 0.0.0
generate:
  packages:
    - type: main
      file: cmd/hints/main.go
    - type: cmd
      file: internal/cmd/hints/zz_hints.go
      package: hints
  features:
    - type: completion
      enabled: true
      embed: true
      embed_dir: internal/cmd/hints/renders
-- cmd/hints/.rotini.spec.yaml --
version: 0.0.0
command:
  name: hints
  summary: completion hints
  flags:
    - name: config
      summary: config file
      identifiers:
        - --config
      schema:
        type: string
        complete:
          kind: file
          extensions:
            - yaml
            - yml
    - name: out
      summary: output directory
      identifiers:
        - --out
      schema:
        type: string
        complete:
          kind: directory
    - name: id
      summary: an opaque identifier
      identifiers:
        - --id
      schema:
        type: string
        complete:
          kind: none
    - name: plain
      summary: no hint at all
      identifiers:
        - --plain
      schema:
        type: string
    - name: format
      summary: a static vocabulary
      identifiers:
        - --format
      schema:
        type: string
        enum:
          - json
          - yaml
    - name: set
      summary: a map with declared keys
      identifiers:
        - --set
      schema:
        type: map
        properties:
          image: { type: string }
          replicas: { type: string }
    - name: owner
      summary: a local account
      identifiers:
        - --owner
      schema:
        type: string
        complete:
          kind: user
  commands:
    - name: open
      summary: open a file
      arguments:
        - name: path
          schema:
            type: string
            complete:
              kind: file
    - name: help
      summary: print help
      arguments:
        - name: command
          schema:
            type: array
            complete:
              kind: command
-- cmd/hints/.rotini.conf.yaml --
version: 0.0.0
generate:
  packages:
    - type: main
      file: cmd/hints/main.go
    - type: cmd
      file: internal/cmd/hints/zz_hints.go
      package: hints
-- internal/cmd/hints/hints.go --
package hints

import (
	"context"

	"github.com/go-rotini/rotini"
)

type base struct {
	rotini.NoCascadingPreRun
	rotini.NoPreRun
	rotini.NoPostRun
	rotini.NoCascadingPostRun
}

type hintsHandler struct{ base }

func (*hintsHandler) Run(ctx context.Context, rtx *rotini.Context) {}
-- internal/cmd/hints/hints_open.go --
package hints

import (
	"context"

	"github.com/go-rotini/rotini"
)

type hintsOpenHandler struct{ base }

func (*hintsOpenHandler) Run(ctx context.Context, rtx *rotini.Context) {}
-- cmd/hints/main.go --
package main

import (
	hints "example.com/hints/internal/cmd/hints"
)

func main() {
	hints.NewProgram(hints.Handlers()).
		Execute()
}
