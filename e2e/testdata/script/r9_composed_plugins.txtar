# R9 — a composed child's plugins, dispatched through the parent.
#
# A child spec composed with $ref brings its whole command tree: including the remote
# commands, discovery and plugin path its root declares. The composed node was once rebuilt
# from its presentation keys alone, so the child's own binary ran `child deploy` while the
# parent answered `root kid deploy` with "takes no arguments". Plugins keep the CHILD's name
# (child-deploy), so one install serves both binaries.

gomodinit example.com/umbrella

exec rotini generate cmd/child/.rotini.spec.yaml --config cmd/child/.rotini.conf.yaml
exec rotini generate cmd/root/.rotini.spec.yaml --config cmd/root/.rotini.conf.yaml
exec go mod tidy

mkdir bin
exec go build -o bin/root$exe ./cmd/root
exec go build -o bin/child$exe ./cmd/child
exec go build -o bin/child-deploy$exe ./plugins/deploy

# The child's own binary, and the same plugin through the parent under its overlay name.
exec bin/child$exe deploy alpha
stdout 'child-deploy got: alpha'
exec bin/root$exe kid deploy beta --plugin-flag
stdout 'child-deploy got: beta --plugin-flag'

-- cmd/child/.rotini.spec.yaml --
version: 0.0.0
command:
  name: child
  summary: a tool with a plugin
  remote_commands:
    - name: deploy
      summary: deploy, via a plugin
-- cmd/child/.rotini.conf.yaml --
version: 0.0.0
generate:
  packages:
    - type: main
      file: cmd/child/main.go
    - type: cmd
      file: internal/cmd/child/zz_child.go
      package: child
-- cmd/root/.rotini.spec.yaml --
version: 0.0.0
command:
  name: root
  summary: an umbrella
  commands:
    - $ref: ../child/.rotini.spec.yaml
      name: kid
-- cmd/root/.rotini.conf.yaml --
version: 0.0.0
generate:
  packages:
    - type: main
      file: cmd/root/main.go
    - type: cmd
      file: internal/cmd/root/zz_root.go
      package: root
-- plugins/deploy/main.go --
package main

import (
	"fmt"
	"os"
	"strings"
)

func main() {
	fmt.Println("child-deploy got: " + strings.Join(os.Args[1:], " "))
}
