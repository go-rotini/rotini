  flags:
    - {name: a, summary: the a, identifiers: [--a], schema: {type: string}}
    - {name: b, summary: the b, identifiers: [-x, --b], schema: {type: string}}
  config_files:
    - name: main
      path: ~/.solo.yaml
      schema: {type: object, properties: {region: {type: string}}}
  plugins:
    - {name: lint, summary: lints, timeout: 10s}
  commands:
