-- cmd/solo/.rotini.conf.yaml --
version: 0.0.0
generate:
  contract:
    file: solo-contract.json
  packages:
    - type: main
      file: cmd/solo/main.go
    - type: cmd
      file: internal/cmd/solo/zz_solo.go
      package: solo
-- cmd/solo/.rotini.spec.yaml --
version: 0.0.0
command:
  name: solo
  summary: one program
  flags:
    - {name: a, summary: the a, identifiers: [-x, --a], schema: {type: string}}
    - {name: b, summary: the b, identifiers: [--b], schema: {type: string}}
  config_files:
    - name: main
      path: ~/.solo.yaml
      schema: {type: object, properties: {region: {type: string}}}
  plugins:
    - {name: lint, summary: lints, timeout: 10s}
  commands:
    - name: read
      summary: reads lines
      stdin: {format: lines}
    - name: debug
      summary: debugging
      hidden: true
      aliases: [dbg]
      flags:
        - {name: trace, summary: traces, identifiers: [--trace], schema: {type: bool}}
-- solo.moved.yaml --
