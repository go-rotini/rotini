-- internal/cmd/io/io_records.go --
package io

import (
	"context"
	"fmt"

	"github.com/go-rotini/rotini"
)

type ioRecordsHandler struct{ base }

func (*ioRecordsHandler) Run(ctx context.Context, rtx *rotini.Context) {
	in, err := rtx.Inputs[IoRecordsInputs]()
	if err != nil {
		fail(rtx, err)
		return
	}
	recs := *in.IoRecords.Stdin
	fmt.Fprintf(rtx.Stdout, "%d records: %s %s\n", len(recs), recs[0].Name, recs[1].Name)
}
