)

type ioTaggedHandler struct{ base }

func (*ioTaggedHandler) Run(ctx context.Context, rtx *rotini.Context) {
	if _, err := rtx.Inputs[IoTaggedInputs](); err != nil {
		fail(rtx, err)
		return
	}
	fmt.Fprintln(rtx.Stdout, "ok")
}
-- internal/cmd/io/io_cat.go --
package io

import (
	"context"
	"fmt"
	"os"
	"strings"

	"github.com/go-rotini/rotini"
)

type ioCatHandler struct{ base }

func (*ioCatHandler) Run(ctx context.Context, rtx *rotini.Context) {
	in, err := rtx.Inputs[IoCatInputs]()
	if err != nil {
		fail(rtx, err)
		return
	}
	if in.IoCat.Stdin != nil {
		fmt.Fprintln(rtx.Stdout, strings.TrimSpace(*in.IoCat.Stdin))
		return
	}
	for _, f := range in.IoCat.Arguments.Files {
		b, _ := os.ReadFile(f)
		fmt.Fprint(rtx.Stdout, string(b))
	}
}
-- internal/cmd/io/io_twice.go --
package io

import (
	"context"
	"fmt"
	"strings"

	"github.com/go-rotini/rotini"
)

type ioTwiceHandler struct{ base }

func (*ioTwiceHandler) Run(ctx context.Context, rtx *rotini.Context) {
	in, err := rtx.Inputs[IoTwiceInputs]()
	if err != nil {
		fail(rtx, err)
		return
	}
	for line := range in.IoTwice.Stdin {
		fmt.Fprintln(rtx.Stdout, "first="+line)
		break
	}
	again, err := rtx.Inputs[IoTwiceInputs]()
	if err != nil {
		fail(rtx, err)
		return
	}
	var rest []string
	for line := range again.IoTwice.Stdin {
		rest = append(rest, line)
	}
	fmt.Fprintln(rtx.Stdout, "then="+strings.Join(rest, ","))
}
