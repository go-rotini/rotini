-- internal/cmd/vals/vals_pages.go --
package vals

import (
	"context"
	"fmt"

	"github.com/go-rotini/rotini"
)

type valsPagesHandler struct {
	rotini.NoCascadingPreRun
	rotini.NoPreRun
	rotini.NoPostRun
	rotini.NoCascadingPostRun
}

func (*valsPagesHandler) Run(ctx context.Context, rtx *rotini.Context) {
	var text string
	var err error
	switch rtx.Argv[len(rtx.Argv)-1] {
	case "help":
		text, err = Help("pages")
	case "man":
		text, err = Man("pages")
	case "markdown":
		text, err = Markdown("pages")
	default:
		in, ierr := rtx.Inputs[ValsPagesInputs]()
		if ierr != nil {
			rtx.HaltWith(ierr)
			return
		}
		f := in.ValsPages.Flags
		text = fmt.Sprintf("fmt=%s jobs=%d token=%s", f.Fmt, f.Jobs, f.Token)
	}
	if err != nil {
		rtx.HaltWith(err)
		return
	}
	fmt.Fprintln(rtx.Stdout, text)
}
