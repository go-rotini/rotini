-- internal/cmd/ks/ks_values.go --
package ks

import (
	"context"
	"fmt"
	"reflect"

	"github.com/go-rotini/rotini"
)

type ksValuesHandler struct{ rotini.NoHooks }

// Run prints each flag as name=value, through its String method where it has one.
func (*ksValuesHandler) Run(ctx context.Context, rtx *rotini.Context) {
	in, err := rtx.Inputs[KsValuesInputs]()
	if err != nil {
		rtx.HaltWith(err)
		return
	}
	v := reflect.ValueOf(&in.KsValues.Flags).Elem()
	for i := range v.NumField() {
		f := v.Field(i)
		var s any = f.Interface()
		if st, ok := f.Addr().Interface().(fmt.Stringer); ok && f.Kind() != reflect.Pointer {
			s = st
		}
		fmt.Fprintf(rtx.Stdout, "%s=%v\n", v.Type().Field(i).Name, s)
	}
}
-- cmd/ks/.rotini.spec.yaml --
version: 0.0.0
command:
  name: ks
  summary: a kitchen sink that uses every runtime feature
  env_prefix: KS
  multicall: true
  response_files: {prefix: "+"}
  config_files:
    - name: app
      path: ./ks.yaml
      profiles: {select: profile, under: profiles}
      schema:
        type: object
        properties:
          region: {type: string}
    - name: local
      path: .env
      as: env
    - name: extra
      path: ./extra.jsonc
  schemas:
    DB:
      type: object
      required: [host]
      properties:
        host: {type: string}
        port: {type: integer, minimum: 1}
    Doc:
      type: object
      required: [name]
      properties:
        name: {type: string}
  flags:
    - name: dir
      summary: run in this directory
      identifiers: [-C, --dir]
      cascading: true
      role: chdir
      schema: {type: string}
    - name: profile
      summary: the configuration profile
      identifiers: [--profile]
      cascading: true
      schema: {type: string}
  plugins:
    - name: ext
      summary: a plugin
  commands:
    - name: doc
      summary: read a YAML document from stdin
      stdin: {format: yaml, schema: {$ref: '#/schemas/Doc'}}
    - name: docs
      summary: read JSON Lines from stdin
      stdin: {format: jsonl, schema: {$ref: '#/schemas/Doc'}}
    - name: tdoc
      summary: read a TOML document from stdin
      stdin: {format: toml, schema: {$ref: '#/schemas/Doc'}}
    - name: env
      summary: read the environment
      env:
        - name: token
          schema: {type: string, variable: KS_TOKEN, variable_file: KS_TOKEN_FILE}
        - name: dotenv
          schema: {type: string, variable: KS_DOTENV}
    - name: config
      summary: read the configuration file
      config:
        - name: region
          schema:
            type: string
            pattern: '^[a-z,-]+$'
            enum:
              - eu-west
              - {value: us-east, aliases: ['us,east']}
              - {value: old, deprecated: gone}
        - name: since
          schema: {type: time, layout: ['2006-01-02 15:04', '2006-01-02']}
        - name: owner
          schema: {type: string}
    - name: fallback
      summary: a flag that falls back to the environment and the configuration file
      flags:
        - name: zone
          summary: the zone
          identifiers: [--zone]
          schema: {type: string, key: zone, variable: KS_ZONE}
    - name: expand
      summary: expand a path
      flags:
        - name: root
          summary: a root directory
          identifiers: [--root]
          schema: {type: string, expand: [home, env]}
    - name: object
      summary: an object flag
      flags:
        - name: db
          summary: the database
          identifiers: [--db]
          schema: {$ref: '#/schemas/DB'}
    - name: bounds
      summary: a bounded flag
      flags:
        - name: port
          summary: the port
          identifiers: [--port]
          schema: {type: int, minimum: 1, maximum: 10}
    - name: pattern
      summary: a patterned flag
      flags:
        - name: name
          summary: the name
          identifiers: [--name]
          schema: {type: string, pattern: '^[a-z]+$'}
    - name: groups
      summary: flags in a group
      flags:
        - {name: a, summary: a, identifiers: [--a], schema: {type: bool}}
        - {name: b, summary: b, identifiers: [--b], schema: {type: bool}}
      flag_groups:
        - {kind: mutually_exclusive, flags: [a, b]}
    - name: deps
      summary: dependent flags
      flags:
        - {name: a, summary: a, identifiers: [--a], schema: {type: bool}}
        - {name: b, summary: b, identifiers: [--b], schema: {type: bool}}
      flag_dependencies:
        - {when: a, requires: [b]}
    - name: stream
      summary: a stream path
      arguments:
        - name: src
          summary: the input
          schema: {type: inputfile}
    - name: values
      summary: every value type
      flags:
        - {name: url, summary: u, identifiers: [--url], schema: {type: url}}
        - {name: email, summary: e, identifiers: [--email], schema: {type: email}}
        - {name: tz, summary: z, identifiers: [--tz], schema: {type: timezone}}
        - {name: mac, summary: m, identifiers: [--mac], schema: {type: mac}}
        - {name: ip, summary: i, identifiers: [--ip], schema: {type: ip}}
        - {name: cidr, summary: c, identifiers: [--cidr], schema: {type: cidr}}
        - {name: hostport, summary: h, identifiers: [--hostport], schema: {type: hostport}}
        - {name: re, summary: r, identifiers: [--re], schema: {type: regexp}}
