# R12 — the secrets recipe: a secret flag refuses a typed value and reads @file or stdin, and a
# hand-built layer fills it from a credential helper, merged below the command line and
# validated with the rest. The handler file is the one the recipes page shows.

gomodinit example.com/secdemo

exec rotini generate cmd/secdemo/.rotini.spec.yaml --config cmd/secdemo/.rotini.conf.yaml
cp sync.go.txt internal/cmd/secdemo/secdemo_sync.go
exec go mod tidy
exec go build -o secdemo$exe ./cmd/secdemo

# A typed token is refused; a file or stdin is read, and the value is never printed.
wantexit 1 ./secdemo$exe sync --token s3cret
stderr 'takes @file or -, not a value'
exec ./secdemo$exe sync --token @token.txt
stdout '^token \[redacted\] from argv \(6 bytes\)$'
stdin token.txt
exec ./secdemo$exe sync --token -
stdout 'from argv'

# Nothing supplies it: the merged report is still checked.
wantexit 1 ./secdemo$exe sync
stderr 'missing required input: --token'

# A credential helper fills it, and a token on the command line still wins.
[!unix] stop 'the helper is a shell script'
chmod 755 helper.sh
env SECDEMO_CREDENTIAL_HELPER=./helper.sh
exec ./secdemo$exe sync
stdout '^token \[redacted\] from credential-helper \(10 bytes\)$'
exec ./secdemo$exe sync --token @token.txt
stdout 'from argv'

-- token.txt --
s3cret
-- helper.sh --
#!/bin/sh
echo fromhelper
-- sync.go.txt --
package secdemo

import (
	"context"
	"fmt"
	"os/exec"
	"strings"

	"github.com/go-rotini/rotini"
)

var _ rotini.Handler = (*secdemoSyncHandler)(nil)

type secdemoSyncHandler struct {
	rotini.NoCascadingPreRun
	rotini.NoPreRun
	rotini.NoPostRun
	rotini.NoCascadingPostRun
}

func (*secdemoSyncHandler) Run(ctx context.Context, rtx *rotini.Context) {
	argv, err := rtx.ArgvInputs[SecdemoSyncInputs]()
	if err != nil {
		rtx.HaltWith(err)
		return
	}
	env, err := rtx.EnvInputs[SecdemoSyncInputs]()
	if err != nil {
		rtx.HaltWith(err)
		return
	}
	layers := []rotini.InputLayer[SecdemoSyncInputs]{env}
	if helper := env.Values.SecdemoSync.Env.CredentialHelper; helper != "" && argv.Values.SecdemoSync.Flags.Token == "" {
		token, err := fromHelper(ctx, helper)
		if err != nil {
			rtx.HaltWith(err)
			return
		}
		var v SecdemoSyncInputs
		v.SecdemoSync.Flags.Token = token
		layers = append(layers, rotini.InputLayer[SecdemoSyncInputs]{Name: "credential-helper", Values: v, Set: rotini.PresenceOf(v)})
	}
	layers = append(layers, argv) // a --token the user gave wins

	in, report := rotini.MergeInputsWithReport(layers...)
	if err := report.Validate(); err != nil {
		rtx.HaltWith(err)
		return
	}
	src, _ := report.Winner("SecdemoSync.Flags.Token")
	fmt.Fprintf(rtx.Stdout, "token %s from %s (%d bytes)\n", src.Raw, src.Layer, len(in.SecdemoSync.Flags.Token))
}

// fromHelper runs a credential helper, `<helper> get`, and returns the first line it prints.
func fromHelper(ctx context.Context, helper string) (string, error) {
	out, err := exec.CommandContext(ctx, helper, "get").Output()
	if err != nil {
		return "", fmt.Errorf("credential helper %s: %w", helper, err)
	}
	token, _, _ := strings.Cut(string(out), "\n")
	return strings.TrimSpace(token), nil
}
-- cmd/secdemo/.rotini.spec.yaml --
version: 0.0.0
command:
  name: secdemo
  summary: read a token from a file, stdin or a helper program, never from argv
  flags:
    - name: help
      summary: print help
      identifiers: [-h, --help]
      cascading: true
      short_circuit: true
      schema: { type: bool }
  commands:
    - name: sync
      summary: sync with the server
      flags:
        - name: token
          summary: the API token, as @file or - for stdin
          identifiers: [--token]
          schema: { type: string, secret: true, required: true, from: [file, stdin] }
      env:
        - name: credential-helper
          summary: a program that prints the token
          schema: { type: string, variable: SECDEMO_CREDENTIAL_HELPER }
-- cmd/secdemo/.rotini.conf.yaml --
version: 0.0.0
generate:
  packages:
    - type: main
      file: cmd/secdemo/main.go
      package: main
    - type: cmd
      file: internal/cmd/secdemo/zz_secdemo.go
      package: secdemo
  features:
    - type: help
      enabled: true
