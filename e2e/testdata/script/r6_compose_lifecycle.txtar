-- internal/cmd/kid/kid_work.go --
package kid

import (
	"context"
	"errors"
	"fmt"

	"example.com/lifecycle/internal/trace"
	"github.com/go-rotini/rotini"
)

var _ rotini.Handler = (*kidWorkHandler)(nil)

type kidWorkHandler struct{ trace.Hooks }

func (*kidWorkHandler) PreRun(ctx context.Context, rtx *rotini.Context) {
	trace.Say(rtx, "PreRun")
	in, err := rtx.Inputs[KidWorkInputs]()
	if err != nil {
		rtx.HaltWith(err)
		return
	}
	if in.KidWork.Flags.Halt {
		rtx.Halt()
	}
}

func (*kidWorkHandler) Run(ctx context.Context, rtx *rotini.Context) {
	trace.Say(rtx, "Run")
	in, err := rtx.Inputs[KidWorkInputs]()
	if err != nil {
		rtx.HaltWith(err)
		return
	}
	if in.KidWork.Flags.Fail {
		rtx.HaltWith(errors.New("work failed"))
		return
	}
	fmt.Fprintf(rtx.Stdout, "work: loud=%v\n", in.Kid.Flags.Loud)
}
-- internal/cmd/kid/kid_secret.go --
package kid

import (
	"context"
	"fmt"

	"example.com/lifecycle/internal/trace"
	"github.com/go-rotini/rotini"
)

var _ rotini.Handler = (*kidSecretHandler)(nil)

type kidSecretHandler struct{ trace.Hooks }

func (*kidSecretHandler) Run(ctx context.Context, rtx *rotini.Context) {
	fmt.Fprintln(rtx.Stdout, "secret ran")
}
