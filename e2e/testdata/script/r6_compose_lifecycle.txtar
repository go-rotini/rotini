package kid

import (
	"context"

	"example.com/lifecycle/internal/trace"
	"github.com/go-rotini/rotini"
)

var _ rotini.Handler = (*kidHandler)(nil)

type kidHandler struct{ trace.Hooks }

func (*kidHandler) CascadingPreRun(ctx context.Context, rtx *rotini.Context) {
	argv, err := rtx.ArgvInputs[KidInputs]()
	if err != nil {
		trace.Say(rtx, "CascadingPreRun")
		rtx.HaltWith(err)
		return
	}
	trace.Answer(rtx, argv.Values.Kid.Flags.Help, argv.Values.Kid.Flags.Version)
}

func (*kidHandler) Run(ctx context.Context, rtx *rotini.Context) {
	trace.Say(rtx, "Run")
	if _, err := rtx.Inputs[KidInputs](); err != nil {
		rtx.HaltWith(err)
		return
	}
	rtx.HaltWithCode(1)
}
