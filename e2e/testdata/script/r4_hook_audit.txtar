# R4 — a misspelled lifecycle hook is reported at generate time.
#
# A handler embeds the No* no-ops and overrides the hooks it wants by declaring methods with
# the same names. A misspelled name is silent: the embed keeps satisfying Handler, so the
# `var _ rotini.Handler` assertion holds, the package compiles, vet is clean, and the hook
# never runs. generate reports it with a file:line, as a warning, since an unused method is
# legal Go. (A missing hook or a drifted signature is a compile error already.)

gomodinit example.com/demo

exec rotini init demo
exec go mod tidy

# The author adds a cascading setup hook — and mistypes it.
cp typo-handler.go.txt internal/cmd/demo/demo.go

# ── the problem: the toolchain is happy ──────────────────────────────────────
exec go build ./...
exec go vet ./...

# ── generate says so, with everything needed to act on it ────────────────────
exec rotini generate cmd/demo/.rotini.spec.yaml --config cmd/demo/.rotini.conf.yaml
stderr '^Warning: internal/cmd/demo/demo\.go:\d+'
stderr 'method "CascadingPrerun" on demoHandler is not a lifecycle hook'
stderr 'will never run'
stderr 'rotini\.NoCascadingPreRun is what supplies CascadingPreRun'
stderr 'did you mean "CascadingPreRun"\?'

# ── and the warning is true: the hook really does not run ────────────────────
exec go build -o demo$exe ./cmd/demo
exec ./demo$exe
stdout 'ran'
! stdout 'setup'

# ── fix the spelling: generate goes quiet and the hook fires ─────────────────
cp fixed-handler.go.txt internal/cmd/demo/demo.go
exec rotini generate cmd/demo/.rotini.spec.yaml --config cmd/demo/.rotini.conf.yaml
! stderr 'Warning:'

exec go build -o demo$exe ./cmd/demo
exec ./demo$exe
stdout 'setup'
stdout 'ran'

-- typo-handler.go.txt --
package demo

import (
	"context"
	"fmt"

	"github.com/go-rotini/rotini"
)

var _ rotini.Handler = (*demoHandler)(nil)

// The embeds are all present, as the seeded stub wrote them. CascadingPreRun below is
// misspelled, so NoCascadingPreRun is what the runtime will call.
type demoHandler struct {
	rotini.NoCascadingPreRun
	rotini.NoPreRun
	rotini.NoPostRun
	rotini.NoCascadingPostRun
}

func (*demoHandler) CascadingPrerun(ctx context.Context, rtx *rotini.Context) {
	fmt.Fprintln(rtx.Stdout, "setup")
}

func (*demoHandler) Run(ctx context.Context, rtx *rotini.Context) {
	fmt.Fprintln(rtx.Stdout, "ran")
}
-- fixed-handler.go.txt --
package demo

import (
	"context"
	"fmt"

	"github.com/go-rotini/rotini"
)

var _ rotini.Handler = (*demoHandler)(nil)

// The same file with the one letter corrected. The embed stays: it is now shadowed, which is
// the normal way to implement a hook.
type demoHandler struct {
	rotini.NoCascadingPreRun
	rotini.NoPreRun
	rotini.NoPostRun
	rotini.NoCascadingPostRun
}

func (*demoHandler) CascadingPreRun(ctx context.Context, rtx *rotini.Context) {
	fmt.Fprintln(rtx.Stdout, "setup")
}

func (*demoHandler) Run(ctx context.Context, rtx *rotini.Context) {
	fmt.Fprintln(rtx.Stdout, "ran")
}
