          summary: the target
          schema: { type: string, required: true }
    - name: lint
      summary: lint a target
      description: Run lint against a target.
      flags:
        - name: name
          summary: the name to use
          schema: { type: 'string' }
        - name: count
          summary: how many times
          schema: { type: 'int' }
        - name: force
