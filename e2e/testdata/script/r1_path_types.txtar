# R1 — existingfile/existingdir, end to end through codegen.
#
# The parser checks a path type only when the emitted Definition keeps the declared type name
# ("existingfile"), while the generated struct field is a plain string. Unit tests build the
# Definition by hand, so only a generated CLI shows that codegen keeps the two apart.

gomodinit example.com/paths

exec rotini generate cmd/paths/.rotini.spec.yaml --config cmd/paths/.rotini.conf.yaml

# The declared names reach the emitted Definition intact, while the generated struct fields
# stay Go types.
grep 'Type: "existingdir"' internal/cmd/paths/zz_paths.go
grep 'Type: "existingfile"' internal/cmd/paths/zz_paths.go
grep 'Type: "count"' internal/cmd/paths/zz_paths.go
grep 'Dir +string' internal/cmd/paths/zz_paths.go
grep 'Config +string' internal/cmd/paths/zz_paths.go
grep 'Verbose +int' internal/cmd/paths/zz_paths.go

exec go mod tidy
exec go build -o paths$exe ./cmd/paths

# Happy path: an existing directory and an existing file both pass, and the handler receives
# them as plain strings.
exec ./paths$exe scan . --config conf.yaml
stdout 'dir=\. config=conf\.yaml verbose=0'

# A missing directory is a usage error naming the argument, raised at parse time — before the
# handler runs, so no partial work happens and the message points at what the user typed.
! exec ./paths$exe scan ./nope
stderr '<dir>: no such directory: "\./nope"'

# The kind is checked too, not just existence: a file is not a directory.
! exec ./paths$exe scan conf.yaml
stderr '<dir>: "conf\.yaml" is not a directory'

# The same for a flag, labelled by the identifier the user typed rather than the input name.
! exec ./paths$exe scan . --config missing.yaml
stderr '--config: no such file: "missing\.yaml"'

# ...and a directory is not a file. The name has to satisfy the pattern for the kind check to
# be what fails, since shape is checked first — see below.
mkdir adir.yaml
! exec ./paths$exe scan . --config adir.yaml
stderr '--config: "adir\.yaml" is a directory, not a file'
# Typed short, reported short: the label is whatever the user wrote.
! exec ./paths$exe scan . -c adir.yaml
stderr '^Error: -c: "adir\.yaml" is a directory, not a file'

# A path type is still a string, so a declared pattern applies to it, and applies first, so a
# path that could never be valid is rejected on its shape rather than on its absence.
! exec ./paths$exe scan . --config conf.txt
stderr 'must match'
! stderr 'no such file'

# count rides the same emitter seam: the Definition keeps "count" so the parser tallies
# occurrences, while the field is an int.
exec ./paths$exe scan . --config conf.yaml -vvv
stdout 'verbose=3'

-- conf.yaml --
kind: config
-- conf.txt --
not a yaml file
-- cmd/paths/.rotini.spec.yaml --
version: 0.0.0
command:
  name: paths
  summary: filesystem input types
  commands:
    - name: scan
      summary: scan a directory
      arguments:
        - name: dir
          summary: the directory to scan
          schema:
            type: existingdir
            required: true
      flags:
        - name: config
          identifiers: ["-c", "--config"]
          summary: a config file
          schema:
            type: existingfile
            pattern: '\.(ya?ml|json)$'
        - name: verbose
          identifiers: ["-v", "--verbose"]
          summary: raise verbosity
          schema:
            type: count
-- cmd/paths/.rotini.conf.yaml --
version: 0.0.0
generate:
  packages:
    - type: main
      file: cmd/paths/main.go
    - type: cmd
      file: internal/cmd/paths/zz_paths.go
      package: paths
-- internal/cmd/paths/paths.go --
package paths

import (
	"context"

	"github.com/go-rotini/rotini"
)

type base struct {
	rotini.NoCascadingPreRun
	rotini.NoPreRun
	rotini.NoPostRun
	rotini.NoCascadingPostRun
}

type pathsHandler struct{ base }

func (*pathsHandler) Run(ctx context.Context, rtx *rotini.Context) {}
-- internal/cmd/paths/paths_scan.go --
package paths

import (
	"context"
	"fmt"

	"github.com/go-rotini/rotini"
)

type pathsScanHandler struct{ base }

func (*pathsScanHandler) Run(ctx context.Context, rtx *rotini.Context) {
	in, err := rtx.Inputs[PathsScanInputs]()
	if err != nil {
		rtx.RecordError(err)
		rtx.HaltWithCode(1)
		return
	}
	// Both path types arrive as plain strings: the check happened at parse time, and what
	// to DO with the path (expand, clean, resolve) is the handler's policy.
	c := in.PathsScan.Flags
	fmt.Fprintf(rtx.Stdout, "dir=%s config=%s verbose=%d\n", in.PathsScan.Arguments.Dir, c.Config, c.Verbose)
}
-- cmd/paths/main.go --
package main

import (
	paths "example.com/paths/internal/cmd/paths"
)

func main() {
	paths.NewProgram(paths.Handlers()).
		Execute()
}
