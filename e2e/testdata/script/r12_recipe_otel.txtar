# R12 — the OpenTelemetry recipe: a middleware around each command's Run starts one span per run
# and passes its context to Run, so a command's own spans are its children, and marks it
# failed when the command failed. The middleware, main.go and the work handler are the ones
# the guide shows; printer.go stands in for an exporter and is not on the page.
# It needs the network on a cold module cache: `go get` fetches third-party modules, so it
# opts in to the module proxy.

gomodinit example.com/tracedemo

exec rotini generate cmd/tracedemo/.rotini.spec.yaml --config cmd/tracedemo/.rotini.conf.yaml
cp trace.go.txt internal/cmd/tracedemo/trace.go
cp main.go.txt cmd/tracedemo/main.go
cp work.go.txt internal/cmd/tracedemo/tracedemo_work.go
env GOPROXY=$ROTINI_NETWORK_GOPROXY
exec go get go.opentelemetry.io/otel@v1.44.0 go.opentelemetry.io/otel/trace@v1.44.0 go.opentelemetry.io/otel/sdk@v1.44.0
exec go mod tidy
exec go build -o tracedemo$exe ./cmd/tracedemo

# The command's span is a child of the run's, which ends last.
exec ./tracedemo$exe work
stdout '^worked$'
cmp stderr want-work.txt

# A failed command marks the run's span.
wantexit 1 ./tracedemo$exe fail
stderr '^span "tracedemo fail" failed$'
stderr 'no luck'

-- want-work.txt --
span "load" in "tracedemo work"
span "tracedemo work"
-- trace.go.txt --
package tracedemo

import (
	"context"

	"github.com/go-rotini/rotini"
	"go.opentelemetry.io/otel"
	"go.opentelemetry.io/otel/codes"
)

var tracer = otel.Tracer("example.com/tracedemo")

// Trace runs each command's Run in a span named after the command, and marks the span failed
// when the command fails.
func Trace(h rotini.Hook, next rotini.HookFunc) rotini.HookFunc {
	if h.Kind != rotini.HookRun {
		return next
	}
	return func(ctx context.Context, rtx *rotini.Context) error {
		ctx, span := tracer.Start(ctx, rtx.CommandPath())
		defer span.End()
		err := next(ctx, rtx)
		// err is what Run returned; Failed also covers an error it recorded.
		if err != nil || rtx.Failed() {
			span.SetStatus(codes.Error, "the command failed")
		}
		return err
	}
}
-- main.go.txt --
//go:generate go tool rotini generate ./.rotini.spec.yaml --config ./.rotini.conf.yaml
package main

import (
	cmd "example.com/tracedemo/internal/cmd/tracedemo"
)

func main() {
	cmd.NewProgram().
		WithMiddleware(cmd.Trace).
		Execute()
}
-- work.go.txt --
package tracedemo

import (
	"context"
	"fmt"

	"github.com/go-rotini/rotini"
)

var _ rotini.ErrorHandler = (*tracedemoWorkHandler)(nil)

type tracedemoWorkHandler struct {
	rotini.NoCascadingPreRunE
	rotini.NoPreRunE
	rotini.NoPostRunE
	rotini.NoCascadingPostRunE
}

func (*tracedemoWorkHandler) Run(ctx context.Context, rtx *rotini.Context) error {
	_, span := tracer.Start(ctx, "load")
	defer span.End()
	fmt.Fprintln(rtx.Stdout, "worked")
	return nil
}
-- internal/cmd/tracedemo/tracedemo_fail.go --
package tracedemo

import (
	"context"
	"errors"

	"github.com/go-rotini/rotini"
)

var _ rotini.ErrorHandler = (*tracedemoFailHandler)(nil)

type tracedemoFailHandler struct {
	rotini.NoCascadingPreRunE
	rotini.NoPreRunE
	rotini.NoPostRunE
	rotini.NoCascadingPostRunE
}

func (*tracedemoFailHandler) Run(ctx context.Context, rtx *rotini.Context) error {
	return errors.New("no luck")
}
-- internal/cmd/tracedemo/printer.go --
package tracedemo

import (
	"context"
	"fmt"
	"os"
	"sync"

	"go.opentelemetry.io/otel"
	"go.opentelemetry.io/otel/codes"
	sdktrace "go.opentelemetry.io/otel/sdk/trace"
	"go.opentelemetry.io/otel/trace"
)

func init() {
	otel.SetTracerProvider(sdktrace.NewTracerProvider(sdktrace.WithSpanProcessor(&printer{names: map[trace.SpanID]string{}})))
}

// printer writes each span to stderr as it ends, naming the span it is a child of.
type printer struct {
	mu    sync.Mutex
	names map[trace.SpanID]string
}

func (p *printer) OnStart(_ context.Context, s sdktrace.ReadWriteSpan) {
	p.mu.Lock()
	defer p.mu.Unlock()
	p.names[s.SpanContext().SpanID()] = s.Name()
}

func (p *printer) OnEnd(s sdktrace.ReadOnlySpan) {
	p.mu.Lock()
	defer p.mu.Unlock()
	line := fmt.Sprintf("span %q", s.Name())
	if parent, ok := p.names[s.Parent().SpanID()]; ok {
		line += fmt.Sprintf(" in %q", parent)
	}
	if s.Status().Code == codes.Error {
		line += " failed"
	}
	fmt.Fprintln(os.Stderr, line)
}

func (*printer) Shutdown(context.Context) error   { return nil }
func (*printer) ForceFlush(context.Context) error { return nil }
-- cmd/tracedemo/.rotini.spec.yaml --
version: 0.0.0
command:
  name: tracedemo
  summary: one span per run
  commands:
    - name: work
      summary: do some traced work
    - name: fail
      summary: fail, marking the span
-- cmd/tracedemo/.rotini.conf.yaml --
version: 0.0.0
generate:
  packages:
    - type: main
      file: cmd/tracedemo/main.go
      package: main
    - type: cmd
      file: internal/cmd/tracedemo/zz_tracedemo.go
      package: tracedemo
      hook_returns: error
  features:
    - type: help
      enabled: true
