-- path.go.txt --
package opsctl

import (
	"context"
	"fmt"

	"github.com/go-rotini/rotini"
)

var _ rotini.Handler = (*opsctlConfigPathHandler)(nil)

type opsctlConfigPathHandler struct {
	rotini.NoCascadingPreRun
	rotini.NoPreRun
	rotini.NoPostRun
	rotini.NoCascadingPostRun
}

func (*opsctlConfigPathHandler) Run(ctx context.Context, rtx *rotini.Context) {
	if _, err := rtx.Inputs[OpsctlConfigPathInputs](); err != nil {
		rtx.HaltWith(err)
		return
	}
	for _, name := range []string{"user", "project", "override"} {
		path, exists, err := rotini.ConfigFilePath(rtx, name)
		if err != nil {
			rtx.HaltWith(err)
			return
		}
		fmt.Fprintf(rtx.Stdout, "%s %s exists=%t\n", name, path, exists)
	}
}
