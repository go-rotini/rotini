    - name: version
      summary: print version
    - name: greet
      summary: greet someone
      flags:
        - name: name
          identifiers: [--name]
          summary: who to greet
          schema: { type: string, default: world }
        - name: times
          identifiers: [--times]
          summary: how many times
          schema: { type: int, default: 1 }
      arguments:
        - name: rest
          summary: anything else
          schema: { type: '[]string' }
