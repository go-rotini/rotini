      arguments:
        - name: command
          summary: the command path to print help for
          schema: { type: '[]string' }
    - name: version
      summary: print version
    - name: say
      summary: say things
      commands:
        - name: hello
          summary: greet someone
          flags:
            - name: name
              identifiers: [--name]
              summary: who to greet
              schema: { type: string, default: world }
    - name: test
      summary: run the checks
    - name: windows
      summary: windows things
    - name: linux
      summary: linux things
      commands:
        - name: amd64
          summary: amd64 things
