-- kick.go.txt --
// kick runs a command, waits until its stderr prints a line containing a word, sends it SIGINT,
// and prints its exit code and the rest of what it wrote to stderr.
package main

import (
	"bufio"
	"errors"
	"fmt"
	"os"
	"os/exec"
	"strings"
)

func main() {
	word := os.Args[1]
	cmd := exec.Command(os.Args[2], os.Args[3:]...)
	stderr, err := cmd.StderrPipe()
	if err != nil {
		panic(err)
	}
	cmd.Stdout = os.Stdout
	if err := cmd.Start(); err != nil {
		panic(err)
	}
	sc := bufio.NewScanner(stderr)
	sent := false
	for sc.Scan() {
		fmt.Println("stderr:", sc.Text())
		if !sent && strings.Contains(sc.Text(), word) {
			cmd.Process.Signal(os.Interrupt)
			sent = true
		}
	}
	err = cmd.Wait()
	code := 0
	var ee *exec.ExitError
	if errors.As(err, &ee) {
		code = ee.ExitCode()
	}
	fmt.Println("exit", code)
}
