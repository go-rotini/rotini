-- dp_test.go.txt --
package dp

import (
	"bytes"
	"os"
	"path/filepath"
	"strings"
	"testing"

	"github.com/go-rotini/rotini"
	"github.com/go-rotini/rotini/rotinitest"
)

func TestCountFile(t *testing.T) {
	t.Parallel()
	dir := t.TempDir()
	if err := os.WriteFile(filepath.Join(dir, "a.txt"), []byte("ab\nb\nab\n"), 0o600); err != nil {
		t.Fatal(err)
	}
	var in DpCountInputs
	in.DpCount.Arguments.Files = []string{"a.txt"}
	in.DpCount.Flags.Match = mustRegexp(t, "a")
	res := rotinitest.Run(t, NewProgram().WithReporter(Report), in, rotinitest.Dir(dir))
	rotinitest.ExitDocumented(t, res)
	if out := rotinitest.Output[DpCountOutput](t, res); out.Lines != 3 || out.Matched != 2 {
		t.Errorf("count = %+v (argv %q)", out, res.Argv)
	}
}

func TestSumStdin(t *testing.T) {
	t.Parallel()
	var in DpSumInputs
	res := rotinitest.Run(t, NewProgram().WithReporter(Report), in,
		rotinitest.Stdin(strings.NewReader("{\"value\":2}\n{\"value\":3}\n")))
	items, err := rotini.DecodeOutput[[]DpSumOutput](NewProgram(), res.Stdout, "json")
	if err != nil || len(items) != 2 || items[1].Total != 5 {
		t.Errorf("items = %+v, %v", items, err)
	}
}

func TestUsageExitCode(t *testing.T) {
	t.Parallel()
	var stderr bytes.Buffer
	code, err := NewProgram().WithReporter(Report).WithStderr(&stderr).Run([]string{"fail", "--code", "300"})
	if code != 2 || err == nil || !strings.Contains(stderr.String(), "dp: run 'dp fail --help' for usage") {
		t.Errorf("code %d, err %v, stderr %q", code, err, stderr.String())
	}
}
