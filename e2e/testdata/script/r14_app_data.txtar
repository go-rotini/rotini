import (
	cmd "example.com/data/internal/cmd/dp"
)

// go build -ldflags "-X main.version=1.2.3" ./cmd/...
var version = "0.0.0"

func main() {
	cmd.NewProgram().
		WithVersion(version).
		WithReporter(cmd.Report).
		Execute()
}
