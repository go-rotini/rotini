# R14 — a data tool built end to end from a JSON spec: files, `-` and a streamed stdin for one
# argument, response files, JSON Lines and a JSON document on stdin checked against their
# schemas, an output file written atomically and refused when it exists, a custom reporter's
# exit codes, the hooks in order through a panic, and Ctrl-C mid-write leaving no file.

gomodinit example.com/data
exec rotini init dp --format json
cp spec.json cmd/dp/.rotini.spec.json
exec rotini generate cmd/dp/.rotini.spec.json --config cmd/dp/.rotini.conf.json
cp main.go.txt cmd/dp/main.go
cp dp.go.txt internal/cmd/dp/dp.go
cp report.go.txt internal/cmd/dp/report.go
cp dp_count.go.txt internal/cmd/dp/dp_count.go
cp dp_convert.go.txt internal/cmd/dp/dp_convert.go
cp dp_sum.go.txt internal/cmd/dp/dp_sum.go
cp dp_stats.go.txt internal/cmd/dp/dp_stats.go
cp dp_slow.go.txt internal/cmd/dp/dp_slow.go
cp dp_fail.go.txt internal/cmd/dp/dp_fail.go
mkdir kick
cp kick.go.txt kick/main.go
exec go mod tidy
exec go build -o dp$exe ./cmd/dp
exec go build -o kicker$exe ./kick
exec go vet ./...

# The handlers' own tests, with typed inputs and an isolated environment.
cp dp_test.go.txt internal/cmd/dp/dp_test.go
cp helpers_test.go.txt internal/cmd/dp/helpers_test.go
exec go test ./internal/cmd/dp

# Files and stdin: `-` reads stdin once, among files or alone, and no file reads it too.
exec ./dp$exe count f1.txt f1.txt -m a
stdout '"lines": 6,'
stdout '"matched": 4'
stdin f1.txt
exec ./dp$exe count
stdout '"lines": 3'
stdin f1.txt
exec ./dp$exe count - f1.txt
stdout '"lines": 6'
wantexit 2 ./dp$exe count - -
stderr '^dp: error: dp count: <files>: "-" \(stdin\) can be given only once; <files> already reads it$'
stderr '^dp: run ''dp count --help'' for usage$'
wantexit 2 ./dp$exe count nope.txt
stderr '^dp: error: dp count: <files>: no such file: "nope\.txt"$'

# A response file holds one argument per line, the command's name included; @@ is a literal @.
exec ./dp$exe @args.rsp
stdout '"lines": 3,'
stdout '"matched": 2'
wantexit 2 ./dp$exe count @@x
stderr 'no such file: "@x"'

# JSON Lines, streamed: each record is checked as it is read and an error names its line once.
stdin records.jsonl
exec ./dp$exe sum
cmp stdout want-sum.jsonl
stdin bad.jsonl
wantexit 2 ./dp$exe sum
stdout '^\{"n":1,"total":1\}$'
stderr '^dp: error: dp sum: stdin line 3: missing required property "value"$'
stdin badtype.jsonl
wantexit 2 ./dp$exe sum
stderr '^dp: error: dp sum: stdin line 1: field "value": value is not of type number$'
stdin empty.txt
wantexit 2 ./dp$exe sum
stderr '^dp: error: dp sum: required stdin payload is empty; pipe JSON Lines$'
# --help never waits for stdin.
exec ./dp$exe sum --help
stdout '^  jsonl Record \(streamed\) \(required\)$'

# A JSON document, whole.
stdin numbers.json
exec ./dp$exe stats
stdout '^n=3 min=1 max=4 mean=2\.6666666666666665$'
stdin nonumbers.json
wantexit 2 ./dp$exe stats
stderr '^dp: error: dp stats: stdin: array length 0 is below minItems 1$'

# An output file is written whole, refused when it exists, replaced with --force; - is stdout.
exec ./dp$exe convert doc.json -o out.json -t compact
cmp out.json want-compact.json
wantexit 2 ./dp$exe convert doc.json -o out.json
stderr 'out\.json'
exec ./dp$exe convert doc.json -o out.json --force
cmp out.json want-pretty.json
stdin doc.json
exec ./dp$exe convert - -t compact
cmp stdout want-compact.json
wantexit 2 ./dp$exe convert doc.json -o nodir/out.json
! exists nodir

# The reporter's codes: 1 for a plain error, the handler's own code, 70 for an internal error
# and for a panic, whose teardown still runs leaf first.
wantexit 1 ./dp$exe fail
stderr '^dp: error: plain failure$'
wantexit 7 ./dp$exe fail --code 7
stderr '^dp: warning: failing on purpose$'
wantexit 70 ./dp$exe fail --internal
wantexit 70 ./dp$exe fail --panic --trace
cmp stderr want-panic.txt
wantexit 2 ./dp$exe fail --code 300
stderr '^dp: error: dp fail: --code must be <= 255 \(got 300\)$'

# Ctrl-C while the output file is open: teardown runs, the reporter says so, the run exits 130
# and no file is left behind.
[!unix] stop 'the rest sends SIGINT'
exec ./kicker$exe writing ./dp$exe slow slow.txt --for 1m --trace
cmp stdout want-interrupt.txt
! exists slow.txt
-- args.rsp --
count
f1.txt
# comment

--match
b
-- bad.jsonl --
{"value":1}

{"label":"x"}
{"value":3}
-- badtype.jsonl --
{"value":"x"}
-- doc.json --
{"b": [1, 2], "a": "x"}
-- dp.go.txt --
package dp

import (
	"context"
	"fmt"

	"github.com/go-rotini/rotini"
)

var _ rotini.HandlerE = (*dpHandler)(nil)

type dpHandler struct {
	rotini.NoPreRunE
	rotini.NoPostRunE
}

func (*dpHandler) CascadingPostRun(ctx context.Context, rtx *rotini.Context) error {
	trace(rtx, "root CascadingPostRun")
	return nil
}

func (*dpHandler) CascadingPreRun(ctx context.Context, rtx *rotini.Context) error {
	trace(rtx, "root CascadingPreRun")
	argv, err := rtx.ArgvInputs[DpInputs]()
	if err != nil {
		return err
	}
	inputs := argv.Values

	if inputs.Dp.Flags.Help {
		page, err := rtx.InvokedHelp()
		if err != nil {
			return err
		}

		if _, err := fmt.Fprintln(rtx.Stdout, page); err != nil {
			return err
		}

		rtx.HaltWithCode(0)
		return nil
	}

	if inputs.Dp.Flags.Version {
		version := rtx.Version()
		if version == "" {
			version = "unknown"
		}

		if _, err := fmt.Fprintln(rtx.Stdout, rtx.CommandChain()[0].Name, version); err != nil {
			return err
		}

		rtx.HaltWithCode(0)
		return nil
	}

	return nil
}

func (*dpHandler) Run(ctx context.Context, rtx *rotini.Context) error {
	if _, err := rtx.Inputs[DpInputs](); err != nil {
		return err
	}

	fmt.Fprintln(rtx.Stderr, rtx.Help())
	rtx.HaltWithCode(1)
	return nil
}
-- dp_convert.go.txt --
package dp

import (
	"context"
	"encoding/json"
	"io"

	"github.com/go-rotini/rotini"
)

var _ rotini.HandlerE = (*dpConvertHandler)(nil)

type dpConvertHandler struct {
	rotini.NoCascadingPreRunE
	rotini.NoPreRunE
	rotini.NoPostRunE
	rotini.NoCascadingPostRunE
}

func (*dpConvertHandler) Run(ctx context.Context, rtx *rotini.Context) error {
	inputs, err := rtx.Inputs[DpConvertInputs]()
	if err != nil {
		return err
	}
	in := inputs.DpConvert
	src, err := rotini.OpenInput(rtx, in.Arguments.Input)
	if err != nil {
		return err
	}
	data, err := io.ReadAll(src)
	src.Close()
	if err != nil {
		return err
	}
	var doc any
	if err := json.Unmarshal(data, &doc); err != nil {
		return rotini.UsageError(err)
	}
	out, err := rotini.CreateOutput(rtx, in.Flags.Out, rotini.OutputOverwrite(in.Flags.Force))
	if err != nil {
		return err
	}
	defer out.Abort()
	enc := json.NewEncoder(out)
	if in.Flags.To == "pretty" {
		enc.SetIndent("", "  ")
	}
	if err := enc.Encode(doc); err != nil {
		return err
	}
	return out.Close()
}
-- dp_count.go.txt --
package dp

import (
	"bufio"
	"context"
	"iter"

	"github.com/go-rotini/rotini"
)

var _ rotini.HandlerE = (*dpCountHandler)(nil)

type dpCountHandler struct {
	rotini.NoCascadingPreRunE
	rotini.NoPostRunE
	rotini.NoCascadingPostRunE
}

func (*dpCountHandler) PreRun(ctx context.Context, rtx *rotini.Context) error {
	trace(rtx, "count PreRun")
	return nil
}

func (*dpCountHandler) Run(ctx context.Context, rtx *rotini.Context) error {
	inputs, err := rtx.Inputs[DpCountInputs]()
	if err != nil {
		return err
	}
	in := inputs.DpCount
	var out DpCountOutput
	count := func(lines iter.Seq2[string, error]) error {
		for line, err := range lines {
			if err != nil {
				return err
			}
			out.Lines++
			if in.Flags.Match != nil && in.Flags.Match.MatchString(line) {
				out.Matched++
			}
		}
		return nil
	}
	files := in.Arguments.Files
	if len(files) == 0 {
		files = []string{"-"}
	}
	for _, name := range files {
		lines := in.Stdin
		if name != "-" {
			f, err := rotini.OpenInput(rtx, name)
			if err != nil {
				return err
			}
			defer f.Close()
			sc := bufio.NewScanner(f)
			lines = func(yield func(string, error) bool) {
				for sc.Scan() {
					if !yield(sc.Text(), nil) {
						return
					}
				}
				if err := sc.Err(); err != nil {
					yield("", err)
				}
			}
		}
		if lines == nil {
			continue // stdin is a terminal
		}
		if err := count(lines); err != nil {
			return err
		}
	}
	return rtx.WriteOutput(out, "json", nil)
}
-- dp_fail.go.txt --
package dp

import (
	"context"
	"errors"

	"github.com/go-rotini/rotini"
)

var _ rotini.HandlerE = (*dpFailHandler)(nil)

type dpFailHandler struct {
	rotini.NoCascadingPreRunE
	rotini.NoPreRunE
	rotini.NoCascadingPostRunE
}

func (*dpFailHandler) Run(ctx context.Context, rtx *rotini.Context) error {
	inputs, err := rtx.Inputs[DpFailInputs]()
	if err != nil {
		return err
	}
	f := inputs.DpFail.Flags
	switch {
	case f.Panic:
		panic("boom")
	case f.Internal:
		rtx.HaltWith(rotini.InternalError(errors.New("the index is corrupt")))
	case f.Code != 0:
		rtx.RecordWarning(errors.New("failing on purpose"))
		rtx.HaltWithCode(f.Code)
	default:
		return errors.New("plain failure")
	}

	return nil
}

func (*dpFailHandler) PostRun(ctx context.Context, rtx *rotini.Context) error {
	trace(rtx, "fail PostRun")
	return nil
}
-- dp_slow.go.txt --
package dp

import (
	"context"
	"fmt"
	"time"

	"github.com/go-rotini/rotini"
)

var _ rotini.HandlerE = (*dpSlowHandler)(nil)

type dpSlowHandler struct {
	rotini.NoCascadingPreRunE
	rotini.NoCascadingPostRunE
}

func (*dpSlowHandler) PreRun(ctx context.Context, rtx *rotini.Context) error {
	trace(rtx, "slow PreRun")
	return nil
}

func (*dpSlowHandler) Run(ctx context.Context, rtx *rotini.Context) error {
	inputs, err := rtx.Inputs[DpSlowInputs]()
	if err != nil {
		return err
	}
	in := inputs.DpSlow
	out, err := rotini.CreateOutput(rtx, in.Arguments.Out, rotini.OutputOverwrite(true))
	if err != nil {
		return err
	}
	fmt.Fprintln(out, "started")
	fmt.Fprintln(rtx.Stderr, "writing", in.Arguments.Out)
	select {
	case <-ctx.Done():
		return ctx.Err()
	case <-time.After(in.Flags.For):
	}
	fmt.Fprintln(out, "finished")
	return out.Close()
}

func (*dpSlowHandler) PostRun(ctx context.Context, rtx *rotini.Context) error {
	fmt.Fprintln(rtx.Stderr, "slow PostRun: cleaned up")
	return nil
}
-- dp_stats.go.txt --
package dp

import (
	"context"
	"fmt"
	"slices"

	"github.com/go-rotini/rotini"
)

var _ rotini.HandlerE = (*dpStatsHandler)(nil)

type dpStatsHandler struct {
	rotini.NoCascadingPreRunE
	rotini.NoPreRunE
	rotini.NoPostRunE
	rotini.NoCascadingPostRunE
}

func (*dpStatsHandler) Run(ctx context.Context, rtx *rotini.Context) error {
	inputs, err := rtx.Inputs[DpStatsInputs]()
	if err != nil {
		return err
	}
	if inputs.DpStats.Stdin == nil {
		return rotini.UsageError(errNoStdin)
	}
	xs := *inputs.DpStats.Stdin
	sum := 0.0
	for _, x := range xs {
		sum += x
	}
	fmt.Fprintf(rtx.Stdout, "n=%d min=%g max=%g mean=%g\n", len(xs), slices.Min(xs), slices.Max(xs), sum/float64(len(xs)))
	return nil
}
-- dp_sum.go.txt --
package dp

import (
	"context"

	"github.com/go-rotini/rotini"
)

var _ rotini.HandlerE = (*dpSumHandler)(nil)

type dpSumHandler struct {
	rotini.NoCascadingPreRunE
	rotini.NoPreRunE
	rotini.NoPostRunE
	rotini.NoCascadingPostRunE
}

func (*dpSumHandler) Run(ctx context.Context, rtx *rotini.Context) error {
	inputs, err := rtx.Inputs[DpSumInputs]()
	if err != nil {
		return err
	}
	if inputs.DpSum.Stdin == nil {
		return rotini.UsageError(errNoStdin)
	}
	var out DpSumOutput
	for rec, err := range inputs.DpSum.Stdin {
		if err != nil {
			return err
		}
		out.N++
		out.Total += rec.Value
		if err := rtx.WriteOutputItem(out, "json", nil); err != nil {
			return err
		}
	}

	return nil
}
