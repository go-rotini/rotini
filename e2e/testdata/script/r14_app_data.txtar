-- report.go.txt --
package dp

import (
	"context"
	"errors"
	"fmt"
	"slices"

	"github.com/go-rotini/rotini"
)

var errNoStdin = errors.New("pipe the data on stdin")

// trace prints a line for a hook when --trace (or DP_TRACE) is on, read from the command line
// and environment only.
func trace(rtx *rotini.Context, what string) {
	if slices.Contains(rtx.Argv, "--trace") || envIs(rtx, "DP_TRACE", "1") {
		fmt.Fprintln(rtx.Stderr, "trace:", what)
	}
}

func envIs(rtx *rotini.Context, name, want string) bool {
	v, _ := rtx.LookupEnv(name)
	return v == want
}

// Report prints every record with a "dp:" prefix and exits 2 for a usage error, 70 for a bug
// or a panic, and 1 otherwise, keeping a signal's 128+n and a handler's own code.
func Report(ctx context.Context, rtx *rotini.Context, out rotini.Outcome) {
	for _, w := range out.Warnings {
		fmt.Fprintln(rtx.Stderr, "dp: warning:", w)
	}
	if ctx.Err() != nil {
		fmt.Fprintln(rtx.Stderr, "dp: interrupted")
		return
	}
	for _, err := range out.Errors {
		fmt.Fprintln(rtx.Stderr, "dp: error:", err)
	}
	for _, p := range out.Panics {
		fmt.Fprintln(rtx.Stderr, "dp: crash:", p.Value)
	}
	switch {
	case len(out.Panics) > 0:
		rtx.Exit(DpExitInternal)
	case len(out.Errors) == 0:
	case rotini.CategoryOf(out.Errors[0]) == rotini.CategoryUsage:
		fmt.Fprintf(rtx.Stderr, "dp: run '%s --help' for usage\n", rtx.CommandPath())
		rtx.Exit(DpExitUsage)
	case rotini.CategoryOf(out.Errors[0]) == rotini.CategoryInternal:
		rtx.Exit(DpExitInternal)
	default:
		rtx.Exit(DpExitFailed)
	}
}
-- spec.json --
{
  "$schema": "./.rotini-schema.spec.json",
  "version": "0.0.0",
  "command": {
    "name": "dp",
    "summary": "a small data pipeline",
    "description": "dp counts, converts and sums data from files and stdin.",
    "response_files": { "prefix": "@" },
    "schemas": {
      "Record": {
        "type": "object",
        "description": "One measurement.",
        "required": ["value"],
        "properties": { "value": { "type": "number" }, "label": { "type": "string" } }
      }
    },
    "exit_status": [
      { "code": 1, "name": "failed", "summary": "something failed" },
      { "code": 2, "name": "usage", "summary": "the command line was wrong" },
      { "code": 70, "name": "internal", "summary": "a bug" }
    ],
    "flags": [
      { "name": "help", "identifiers": ["-h", "--help"], "summary": "print help", "cascading": true, "short_circuit": true, "schema": { "type": "bool" } },
      { "name": "version", "identifiers": ["--version"], "summary": "print version", "cascading": true, "short_circuit": true, "schema": { "type": "bool" } },
      { "name": "trace", "identifiers": ["--trace"], "summary": "print each hook as it runs", "cascading": true, "schema": { "type": "bool", "variable": "DP_TRACE" } }
    ],
    "commands": [
      { "name": "help", "summary": "print help", "arguments": [ { "name": "command", "schema": { "type": "[]string", "complete": { "kind": "command" } } } ] },
      { "name": "version", "summary": "print version" },
      {
        "name": "count",
        "summary": "count lines",
        "arguments": [
          { "name": "files", "summary": "files to read", "schema": { "type": "[]inputfile" } }
        ],
        "flags": [
          { "name": "match", "identifiers": ["-m", "--match"], "summary": "count only lines matching", "schema": { "type": "regexp" } }
        ],
        "stdin": { "format": "lines", "stream": true, "unless_argument": "files" },
        "output": {
          "type": "object",
          "required": ["lines"],
          "properties": { "lines": { "type": "integer" }, "matched": { "type": "integer" } }
        }
      },
      {
        "name": "convert",
        "summary": "convert a JSON document",
        "arguments": [
          { "name": "input", "summary": "the document", "schema": { "type": "inputfile", "required": true } }
        ],
        "flags": [
          { "name": "to", "identifiers": ["-t", "--to"], "summary": "the format to write", "schema": { "type": "string", "default": "pretty", "enum": ["pretty", "compact"] } },
          { "name": "out", "identifiers": ["-o", "--out"], "summary": "where to write", "schema": { "type": "outputfile", "default": "-" } },
          { "name": "force", "identifiers": ["-f", "--force"], "summary": "replace an existing file", "role": "force", "schema": { "type": "bool" } }
        ]
      },
      {
        "name": "sum",
        "summary": "sum the values of JSON lines",
        "stdin": {
          "format": "jsonl",
          "stream": true,
          "schema": { "$ref": "#/schemas/Record", "required": true }
        },
        "output_stream": true,
        "output": {
          "type": "object",
          "required": ["n", "total"],
          "properties": { "n": { "type": "integer" }, "total": { "type": "number" } }
        }
      },
      {
        "name": "stats",
        "summary": "describe a JSON array of numbers",
        "stdin": { "format": "json", "schema": { "type": "array", "items": { "type": "number" }, "minItems": 1, "required": true } }
      },
      {
        "name": "slow",
        "summary": "write a file slowly",
        "arguments": [
          { "name": "out", "summary": "the file", "schema": { "type": "outputfile", "required": true } }
        ],
        "flags": [
          { "name": "for", "identifiers": ["--for"], "summary": "how long", "schema": { "type": "duration", "default": "10s" } }
        ]
      },
      {
        "name": "fail",
        "summary": "fail on purpose",
        "flags": [
          { "name": "code", "identifiers": ["--code"], "summary": "exit with this code", "schema": { "type": "int", "minimum": 0, "maximum": 255 } },
          { "name": "panic", "identifiers": ["--panic"], "summary": "panic instead", "schema": { "type": "bool" } },
          { "name": "internal", "identifiers": ["--internal"], "summary": "fail with an internal error", "schema": { "type": "bool" } }
        ]
      }
    ]
  }
}
