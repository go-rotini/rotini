# R3 — a stdout that can't be written makes the run fail, with buffered output flushed and
# checked before the reporter runs. /dev/full (Linux) fails every write with ENOSPC.

gomodinit example.com/report

exec rotini generate cmd/report/.rotini.spec.yaml --config cmd/report/.rotini.conf.yaml
exec go mod tidy
exec go build -o report$exe ./cmd/report

# Buffered output reaches a file whole, after the handler returns.
execout out.txt ./report$exe
cmp out.txt want.txt

# The handler ignores its write errors; the final flush still reports the failure.
[linux] ! execout /dev/full ./report$exe
[linux] stderr '^Error: write output: no space left on device$'

# An output file on a full device fails as it is written, not silently.
[linux] ! exec ./report$exe --to /dev/full
[linux] stderr 'no space left on device'

# The companion buffers its own output, so a full disk fails `rotini completion`.
[linux] ! execout /dev/full rotini completion bash
[linux] stderr 'no space left on device'

# Stubs seeded for an older project shape (--help not short_circuit) check their writes too.
exec rotini generate cmd/old/.rotini.spec.yaml --config cmd/old/.rotini.conf.yaml
exec go build -o old$exe ./cmd/old
grep 'if _, err := fmt.Fprintln\(rtx.Stdout, version\); err != nil' internal/cmd/old/old_version.go
exec ./old$exe version
stdout '^0\.0\.0$'
[linux] ! execout /dev/full ./old$exe --help
[linux] stderr 'no space left on device'
[linux] ! execout /dev/full ./old$exe --version
[linux] stderr 'no space left on device'
[linux] ! execout /dev/full ./old$exe build x
[linux] stderr 'no space left on device'
[linux] ! execout /dev/full ./old$exe help
[linux] stderr 'no space left on device'
[linux] ! execout /dev/full ./old$exe version
[linux] stderr 'no space left on device'

-- want.txt --
line 1
line 2
line 3
-- cmd/report/.rotini.spec.yaml --
version: 0.0.0
command:
  name: report
  summary: write a few lines
  flags:
    - name: to
      identifiers: [--to]
      summary: where to write
      schema:
        type: outputfile
        default: '-'
-- cmd/report/.rotini.conf.yaml --
version: 0.0.0
generate:
  packages:
    - type: main
      file: cmd/report/main.go
    - type: cmd
      file: internal/cmd/report/zz_report.go
      package: report
-- cmd/report/main.go --
package main

import (
	report "example.com/report/internal/cmd/report"
)

func main() {
	report.NewProgram(report.Handlers()).
		WithBufferedOutput(true).
		Execute()
}
-- internal/cmd/report/report.go --
package report

import (
	"context"
	"fmt"

	"github.com/go-rotini/rotini"
)

type reportHandler struct {
	rotini.NoHooks
}

func (*reportHandler) Run(ctx context.Context, rtx *rotini.Context) {
	in, err := rtx.Inputs[ReportInputs]()
	if err != nil {
		rtx.HaltWith(err)
		return
	}
	out, err := rotini.CreateOutput(rtx, in.Report.Flags.To, rotini.Overwrite(true))
	if err != nil {
		rtx.HaltWith(err)
		return
	}
	defer out.Abort()
	for i := 1; i <= 3; i++ {
		fmt.Fprintf(out, "line %d\n", i)
	}
	if err := out.Close(); err != nil {
		rtx.HaltWith(err)
	}
}
-- cmd/old/.rotini.spec.yaml --
version: 0.0.0
command:
  name: old
  summary: an older project shape
  flags:
    - name: help
      identifiers: [-h, --help]
      cascading: true
      schema: { type: bool }
    - name: version
      identifiers: [-v, --version]
      schema: { type: bool }
  commands:
    - name: build
      summary: build it
      arguments:
        - name: target
          schema: { type: string, required: true }
    - name: help
      summary: print help
      arguments:
        - name: command
          schema: { type: '[]string' }
    - name: version
      summary: print version
-- cmd/old/.rotini.conf.yaml --
version: 0.0.0
generate:
  packages:
    - type: main
      file: cmd/old/main.go
      package: main
    - type: cmd
      file: internal/cmd/old/zz_old.go
      package: old
  features:
    - type: help
      enabled: true
