# R12 — the testscript recipe: a test in the main package runs the program's own main as a
# command in script files, with the user's config directory kept out. The test file and the
# script are the ones the recipes page shows.

gomodinit example.com/tsdemo

exec rotini generate cmd/tsdemo/.rotini.spec.yaml --config cmd/tsdemo/.rotini.conf.yaml
cp hello.go.txt internal/cmd/tsdemo/tsdemo_hello.go
cp main_test.go.txt cmd/tsdemo/main_test.go
mkdir cmd/tsdemo/testdata/script
cp hello.txtar.txt cmd/tsdemo/testdata/script/hello.txtar
exec go get github.com/rogpeppe/go-internal@v1.16.0
exec go mod tidy
exec go test ./cmd/tsdemo
stdout '^ok'

-- main_test.go.txt --
package main

import (
	"path/filepath"
	"testing"

	"github.com/rogpeppe/go-internal/testscript"
)

// TestMain lets scripts run this program's main as the command tsdemo.
func TestMain(m *testing.M) {
	testscript.Main(m, map[string]func(){"tsdemo": main})
}

func TestScripts(t *testing.T) {
	testscript.Run(t, testscript.Params{
		Dir:                 "testdata/script",
		RequireExplicitExec: true,
		Setup: func(env *testscript.Env) error {
			// Each script gets its own config directory, never the user's.
			env.Setenv("XDG_CONFIG_HOME", filepath.Join(env.WorkDir, ".config"))
			return nil
		},
	})
}
-- hello.txtar.txt --
# hello greets on stdout and writes nothing to stderr.
exec tsdemo hello
stdout '^hello$'
! stderr .

# A mistyped command fails with a usage error.
! exec tsdemo helo
stderr 'unknown command "helo"'
-- hello.go.txt --
package tsdemo

import (
	"context"
	"fmt"

	"github.com/go-rotini/rotini"
)

var _ rotini.Handler = (*tsdemoHelloHandler)(nil)

type tsdemoHelloHandler struct {
	rotini.NoCascadingPreRun
	rotini.NoPreRun
	rotini.NoPostRun
	rotini.NoCascadingPostRun
}

func (*tsdemoHelloHandler) Run(ctx context.Context, rtx *rotini.Context) {
	fmt.Fprintln(rtx.Stdout, "hello")
}
-- cmd/tsdemo/.rotini.spec.yaml --
version: 0.0.0
command:
  name: tsdemo
  summary: a program tested with testscript
  flags:
    - name: help
      summary: print help
      identifiers: [-h, --help]
      cascading: true
      short_circuit: true
      schema: { type: bool }
  commands:
    - name: hello
      summary: print a greeting
-- cmd/tsdemo/.rotini.conf.yaml --
version: 0.0.0
generate:
  packages:
    - type: main
      file: cmd/tsdemo/main.go
      package: main
    - type: cmd
      file: internal/cmd/tsdemo/zz_tsdemo.go
      package: tsdemo
  features:
    - type: help
      enabled: true
