-- check.go.txt --
package inidemo

import (
	"context"
	"fmt"

	"github.com/go-rotini/rotini"
)

var _ rotini.HandlerE = (*inidemoCheckHandler)(nil)

type inidemoCheckHandler struct {
	rotini.NoCascadingPreRunE
	rotini.NoPreRunE
	rotini.NoPostRunE
	rotini.NoCascadingPostRunE
}

func (*inidemoCheckHandler) Run(ctx context.Context, rtx *rotini.Context) error {
	in, err := rtx.Inputs[InidemoCheckInputs]()
	if err != nil {
		return err
	}
	fmt.Fprintln(rtx.Stdout, "replicas:", in.InidemoCheck.Config.Replicas)
	return nil
}
-- cmd/inidemo/.rotini.spec.yaml --
version: 0.0.0
command:
  name: inidemo
  summary: reads its settings from YAML and from an old tool's INI file
  schemas:
    Settings:
      type: object
      properties:
        deploy:
          type: object
          properties:
            region: { type: string }
          additionalProperties: false
  config_files:
    - name: main
      path: inidemo.yaml
  flags:
    - name: help
      summary: print help
      identifiers: [-h, --help]
      cascading: true
      short_circuit: true
      schema: { type: bool }
  commands:
    - name: greet
      summary: print the greeting
      config:
        - name: greeting
          summary: what to greet with
          schema: { type: string, default: hello, key: greeting, file: main }
    - name: show
      summary: print the region from the INI file
      config_files:
        - name: legacy
          path: legacy.ini
          format: ini
      config:
        - name: region
          summary: the region to deploy to
          schema: { type: string, key: deploy.region, file: legacy }
    - name: check
      summary: read a file whose schema allows only the keys it lists
      config_files:
        - name: strict
          path: strict.yaml
          schema:
            type: object
            properties:
              deploy:
                type: object
                properties:
                  replicas: { type: integer }
                  timeout: { type: string }
                additionalProperties: false
            additionalProperties: false
      config:
        - name: replicas
          summary: how many to run
          schema: { type: int, key: deploy.replicas, file: strict }
    - name: load
      summary: read settings piped on stdin
      stdin:
        format: ini
        schema: { $ref: Settings, required: true }
-- cmd/inidemo/.rotini.conf.yaml --
version: 0.0.0
generate:
  packages:
    - type: main
      file: cmd/inidemo/main.go
      package: main
    - type: cmd
      file: internal/cmd/inidemo/zz_inidemo.go
      package: inidemo
      hook_returns: error
  features:
    - type: help
      enabled: true
