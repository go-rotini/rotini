# R1 — the precedence ladder, proven from outside the binary.
#
# defaults < config file < environment < argv. The conformance matrix proves this in-process
# against hand-written structs; this proves it for a binary codegen actually produced, which
# matters because a swap in generated tags would pass every other tier.

gomodinit example.com/prec

exec rotini generate cmd/app/.rotini.spec.yaml --config cmd/app/.rotini.conf.yaml
exec go mod tidy
exec go build -o app$exe ./cmd/app

# 1. Nothing supplied — the declared config path does not exist, so the channel is absent
#    and the declared default wins.
exec ./app$exe
stdout 'port=8080'
stdout 'region=default-region'

# 2. A config file beats the default.
exec ./app$exe --conf app.yaml
stdout 'port=9090'

# 3. The environment beats the config file.
env APP_SERVER_PORT=7070
exec ./app$exe --conf app.yaml
stdout 'port=7070'

# 4. argv beats everything.
exec ./app$exe --conf app.yaml --port 6060
stdout 'port=6060'

# Env still loses to argv even with no config file in play.
exec ./app$exe --port 5050
stdout 'port=5050'

env APP_SERVER_PORT=
env APP_REGION=eu-west
exec ./app$exe
stdout 'region=eu-west'

# A value that violates a declared constraint is a usage error naming the input, on stderr.
env APP_SERVER_PORT=
env APP_REGION=
! exec ./app$exe --port 99999
stderr 'port'
! stdout 'port=99999'

# The same violation from the flag's environment variable names where the value came from, so
# the user can find it.
env APP_SERVER_PORT=99999
! exec ./app$exe
stderr '\(from environment variable APP_SERVER_PORT\)'
env APP_SERVER_PORT=

# A flag can name its own environment variable (schema `variable:`) instead of taking the
# SNAKE_UPPER of a config key it does not otherwise want. The named variable is exempt from
# env_prefix — it is already exact — so this is GITHUB_TOKEN, not APP_GITHUB_TOKEN.
env GITHUB_TOKEN=from-the-env
exec ./app$exe
stdout 'token=from-the-env'

# The prefixed spelling must not bind: an explicitly named variable is exact.
env GITHUB_TOKEN=
env APP_GITHUB_TOKEN=wrong
exec ./app$exe
stdout 'token= '

# argv still beats it.
env GITHUB_TOKEN=from-the-env
exec ./app$exe --token from-argv
stdout 'token=from-argv'

# A derived variable name must be the one help prints, and it must actually bind. Codegen
# writes the exact name into the field's `env:` tag rather than letting recon re-derive it,
# which matters for names with an underscore inside a segment (base_url) or in camelCase.
env GITHUB_TOKEN=
env APP_GITHUB_TOKEN=

# An env input whose name carries an underscore.
env APP_BASE_URL=from-underscore
exec ./app$exe
stdout 'base=from-underscore'
env APP_BASE_URL=

# A camelCase env input: one word to a reader, two to SNAKE_UPPER.
env APP_API_KEY=from-camel
exec ./app$exe
stdout 'key=from-camel'
env APP_API_KEY=

# The spelling recon would derive (APP_APIKEY) must not bind: help never offers it.
env APP_APIKEY=wrong
exec ./app$exe
stdout 'key= '
env APP_APIKEY=

# A flag's env fallback, derived from a recon key with an underscore inside a segment.
env APP_SERVER_SORT_BY=title
exec ./app$exe
stdout 'sort=title'
env APP_SERVER_SORT_BY=

# Whatever help prints is what binds — the property, not four examples of it.
exec ./app$exe --help
stdout 'APP_BASE_URL'
stdout 'APP_API_KEY'

# A flag's fallbacks are on the line under it: the variables it reads, then its config key,
# since this command reads a config file. These are the names the cases above set.
stdout '^\s+also set by APP_SERVER_PORT or config key server\.port$'
stdout '^\s+also set by GITHUB_TOKEN or config key token$'
stdout '^\s+also set by APP_SERVER_SORT_BY or config key server\.sort_by$'
# An argv-only flag gets no line.
stdout '--conf string +path to the config file\n +--\[no-\]color'

# A negatable bool expresses the direction a plain bool cannot: turning something off for one
# run when a default or the environment already turned it on. Both forms appear in help as
# one row.
env GITHUB_TOKEN=
exec ./app$exe
stdout 'color=true'

exec ./app$exe --no-color
stdout 'color=false'

exec ./app$exe --color
stdout 'color=true'

# Last one wins, in both directions.
exec ./app$exe --no-color --color
stdout 'color=true'
exec ./app$exe --color --no-color
stdout 'color=false'

# The negated form carries no value — that would be two answers to one question.
! exec ./app$exe --no-color=true
stderr 'negated form'

exec ./app$exe --help
stdout '--\[no-\]color'
! stdout 'explain-inputs'

# An author-declared short-circuit flag prints where each value came from, the winner first
# and then what it overrode. A secret prints redacted.
env APP_SERVER_PORT=7070
env GITHUB_TOKEN=s3cret
exec ./app$exe --conf app.yaml --explain-inputs
cmp stdout explain.txt
! stdout s3cret
env APP_SERVER_PORT=
env GITHUB_TOKEN=

-- explain.txt --
App.Env.APIKey = "" from env:APP_API_KEY
App.Env.BaseURL = "" from env:APP_BASE_URL
App.Env.Region = "" from env:APP_REGION; overrides default "default-region"
App.Flags.Color = "true" from default
App.Flags.Conf = "app.yaml" from argv:--conf
App.Flags.ExplainInputs = "true" from argv:--explain-inputs
App.Flags.Port = "7070" from env:APP_SERVER_PORT; overrides config:appconf#server.port "9090", default "8080"
App.Flags.Token = [redacted] from env:GITHUB_TOKEN
-- app.yaml --
server:
  port: 9090
-- cmd/app/.rotini.spec.yaml --
version: 0.0.0
command:
  name: app
  summary: precedence demo
  description: Proves defaults < file < env < argv.
  env_prefix: APP
  config_files:
    # A declared path that does not exist is simply absent, which is what makes step 1
    # below a clean "nothing supplied". --conf then points the channel at a real file.
    - name: appconf
      path: ./absent.yaml
  flags:
    - name: help
      summary: print help
      identifiers:
        - -h
        - --help
      schema:
        type: bool
    - name: conf
      summary: path to the config file
      identifiers:
        - --conf
      schema:
        type: string
        config_source: appconf
    - name: color
      summary: colorize output
      identifiers:
        - --color
      schema:
        type: bool
        default: true
        negatable: true
    - name: token
      summary: an API token, read from an exactly-named variable
      identifiers:
        - --token
      schema:
        type: string
        secret: true
        variable: GITHUB_TOKEN
    - name: port
      summary: the port to listen on
      identifiers:
        - --port
      schema:
        type: int
        key: server.port
        default: 8080
        minimum: 1
        maximum: 65535
    - name: sort-by
      summary: ordering, whose env fallback is derived from its config key
      identifiers:
        - --sort-by
      schema:
        type: string
        key: server.sort_by
    - name: explain-inputs
      summary: print where each input's value came from
      identifiers:
        - --explain-inputs
      short_circuit: true
      hidden: true
      schema:
        type: bool
  env:
    - name: region
      summary: the deployment region
      schema:
        type: string
        default: default-region
    - name: base_url
      summary: an env input whose name carries an underscore
      schema:
        type: string
    - name: apiKey
      summary: a camelCase env input
      schema:
        type: string
-- cmd/app/.rotini.conf.yaml --
version: 0.0.0
generate:
  packages:
    - type: main
      file: cmd/app/main.go
    - type: cmd
      file: internal/cmd/app/zz_app.go
      package: app
  features:
    - type: help
      enabled: true
-- internal/cmd/app/app.go --
package app

import (
	"context"
	"fmt"

	"github.com/go-rotini/rotini"
)

var _ rotini.Handler = (*appHandler)(nil)

type appHandler struct {
	rotini.NoCascadingPreRun
	rotini.NoPreRun
	rotini.NoPostRun
	rotini.NoCascadingPostRun
}

func (*appHandler) Run(ctx context.Context, rtx *rotini.Context) {
	in, rep, err := rtx.InputsWithReport[AppInputs]()
	if in.App.Flags.ExplainInputs {
		_ = rep.Format(rtx.Stdout)
		return
	}
	if err != nil {
		rtx.RecordError(err)
		rtx.HaltWithCode(1)
		return
	}
	if in.App.Flags.Help {
		fmt.Fprintln(rtx.Stdout, HelpApp)
		return
	}
	fmt.Fprintf(rtx.Stdout, "port=%d region=%s token=%s color=%v base=%s key=%s sort=%s\n",
		in.App.Flags.Port, in.App.Env.Region, in.App.Flags.Token, in.App.Flags.Color,
		in.App.Env.BaseURL, in.App.Env.APIKey, in.App.Flags.SortBy)
}
