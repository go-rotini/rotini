# R0 — a main.go that still uses the generated Program variable gets told how to change it.
#
# Generated code no longer declares Program; main builds the program with
# NewProgram(Handlers()). main.go belongs to the author and is never rewritten, so generate
# names the file and the line to use instead, and leaves the file as it was.

gomodinit example.com/demo

exec rotini init demo
exec go mod tidy
cp old-main.go.txt cmd/demo/main.go

exec rotini generate cmd/demo/.rotini.spec.yaml --config cmd/demo/.rotini.conf.yaml
stderr 'cmd/demo/main.go uses cmd.Program, which generated code no longer declares; build the program with cmd.NewProgram\(cmd.Handlers\(\)\)'
cmp cmd/demo/main.go old-main.go.txt

! exec go build ./...
stderr 'undefined: cmd.Program'

# After the one-line change, generate is quiet about it and the program builds.
cp new-main.go.txt cmd/demo/main.go
exec rotini generate cmd/demo/.rotini.spec.yaml --config cmd/demo/.rotini.conf.yaml
! stderr 'Program'
exec go build ./...

-- old-main.go.txt --
package main

import (
	cmd "example.com/demo/internal/cmd/demo"
)

func main() {
	cmd.Program.Execute()
}
-- new-main.go.txt --
package main

import (
	cmd "example.com/demo/internal/cmd/demo"
)

func main() {
	cmd.NewProgram(cmd.Handlers()).Execute()
}
