        "identifiers": [
          "--color"
        ],
        "cascading": true,
        "schema": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto"
        }
      }
    ],
    "env": [
      {
        "name": "token",
        "summary": "the API token",
        "schema": {
          "type": "string",
          "secret": true
        }
      }
    ],
    "config": [
      {
        "name": "region",
        "summary": "the default region",
        "schema": {
          "type": "string",
          "key": "region",
          "pattern": "^[a-z]+-[0-9]$"
        }
      }
    ],
    "topics": [
      {
        "name": "filters",
        "summary": "how filters work",
        "body": "A filter narrows a list."
      }
    ],
    "schemas": {
      "Task": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "what to do"
          },
          "due": {
            "type": "string",
            "description": "when it is due"
          }
        }
      }
    },
    "commands": [
      {
        "name": "deploy",
        "summary": "ship a service",
        "aliases": [
          "ship"
        ],
        "effects": {
          "kind": "write"
        },
        "arguments": [
          {
            "name": "service",
            "summary": "the service to ship",
            "schema": {
              "type": "string",
              "required": true
            }
          }
        ],
        "flags": [
          {
            "name": "port",
            "summary": "listen port",
            "identifiers": [
              "--port",
              "-p"
            ],
            "schema": {
              "type": "int",
              "default": 8080,
              "minimum": 1,
              "maximum": 65535
            }
          },
          {
            "name": "tag",
            "summary": "a label",
            "identifiers": [
              "--tag"
            ],
            "schema": {
              "type": "[]string",
              "separator": ","
            }
          }
        ]
      },
      {
        "name": "import",
        "summary": "import tasks",
        "stdin": {
          "format": "json",
          "schema": {
            "$ref": "Task"
          }
        }
      }
    ]
  }
}
