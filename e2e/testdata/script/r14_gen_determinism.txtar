{"name":"deploy","summary":"ship a service","aliases":["ship"],"effects":{"kind":"write"},"arguments":[{"name":"service","summary":"the service to ship","schema":{"type":"string","required":true}}],"flags":[{"name":"port","summary":"listen port","identifiers":["--port","-p"],"schema":{"type":"int","default":8080,"minimum":1,"maximum":65535}},{"name":"tag","summary":"a label","identifiers":["--tag"],"schema":{"type":"[]string","separator":","}}]},{"name":"import","summary":"import tasks","stdin":{"format":"json","schema":{"$ref":"Task"}}}]}}
-- spec.toml --
version = "0.0.0"

[command]
name = "ops"
summary = "run the fleet"
env_prefix = "OPS"
[[command.config_files]]
name = "user"
path = "~/.ops.yaml"
[[command.flags]]
name = "help"
summary = "print help"
identifiers = ["--help", "-h"]
cascading = true
short_circuit = true
schema = { type = "bool" }
[[command.flags]]
name = "color"
summary = "when to color"
identifiers = ["--color"]
cascading = true
schema = { type = "string", enum = ["auto", "always", "never"], default = "auto" }
[[command.env]]
name = "token"
summary = "the API token"
schema = { type = "string", secret = true }
[[command.config]]
name = "region"
summary = "the default region"
schema = { type = "string", key = "region", pattern = "^[a-z]+-[0-9]$" }
[[command.topics]]
name = "filters"
summary = "how filters work"
body = "A filter narrows a list."
[[command.commands]]
name = "deploy"
summary = "ship a service"
aliases = ["ship"]
effects = { kind = "write" }
[[command.commands.arguments]]
name = "service"
summary = "the service to ship"
schema = { type = "string", required = true }
[[command.commands.flags]]
name = "port"
summary = "listen port"
identifiers = ["--port", "-p"]
schema = { type = "int", default = 8080, minimum = 1, maximum = 65535 }
[[command.commands.flags]]
name = "tag"
summary = "a label"
identifiers = ["--tag"]
schema = { type = "[]string", separator = "," }
[[command.commands]]
name = "import"
summary = "import tasks"

[command.commands.stdin]
format = "json"
schema = { "$ref" = "Task" }

[command.schemas.Task]
type = "object"
required = ["title"]

[command.schemas.Task.properties]
title = { type = "string", description = "what to do" }
due = { type = "string", description = "when it is due" }
-- conf.yaml --
version: 0.0.0
generate:
  contract:
    file: contract.json
  packages:
    - type: main
      file: cmd/ops/main.go
    - type: cmd
      file: internal/cmd/ops/zz_rotini.go
  features:
    - type: help
      enabled: true
    - type: completion
      enabled: true
    - type: man
      enabled: true
    - type: markdown
      enabled: true
    - type: config_example
      enabled: true
    - type: env_example
      enabled: true
    - type: tools
      enabled: true
      targets: [mcp, openai-strict, gemini]
    - type: skill
      enabled: true
    - type: llms
      enabled: true
      base_url: https://example.com/ops/
    - type: carapace
      enabled: true
