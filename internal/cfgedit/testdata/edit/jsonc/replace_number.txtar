-- in --
// app config
{
  // where to deploy
  "deploy": {
    "timeout": "5m", // line comment
    "retries": 3,
    "tags": ["a", "b"]
  },
  /* logging */
  "log": {"level": "info"}
}
-- op --
set deploy.retries 4
-- out --
// app config
{
  // where to deploy
  "deploy": {
    "timeout": "5m", // line comment
    "retries": 4,
    "tags": ["a", "b"]
  },
  /* logging */
  "log": {"level": "info"}
}
