-- in --
// app config
{
  // where to deploy
  "deploy": {
    "timeout": "5m", // line comment
    "retries": 3,
    "tags": ["a", "b"]
  },
  /* logging */
  "log": {"level": "info"}
}
-- op --
set log.file "/tmp/a.log"
-- out --
// app config
{
  // where to deploy
  "deploy": {
    "timeout": "5m", // line comment
    "retries": 3,
    "tags": ["a", "b"]
  },
  /* logging */
  "log": {"level": "info", "file": "/tmp/a.log"}
}
