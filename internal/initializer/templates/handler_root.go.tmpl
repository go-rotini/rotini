package {{.Package}}

import (
	"context"

	"github.com/go-rotini/rotini"
)

type {{.HandlersType}} struct{
	rotini.DefaultCascadingPreRun
	rotini.DefaultPreRun
	rotini.DefaultPostRun
	rotini.DefaultCascadingPostRun
}

var _ rotini.CommandHandlers = (*{{.HandlersType}})(nil)

func (*{{.HandlersType}}) Run(ctx context.Context, rtx *rotini.Context) {
	parser := rotini.MustGet[*rotini.Parser](rtx, "parser")

	var inputs {{.RootCommandName}}Inputs
	if err := parser.Parse(rtx, &inputs); err != nil {
		fmt.Fprintf(rtx.Stderr, "Error: %v\n\n", err)
		fmt.Fprintln(rtx.Stdout, {{.HelpVar}})
		rtx.SignalExit(1)
		return
	}

	flags := inputs.{{.RootCommandName}}.Flags
	switch {
	case flags.Help:
		fmt.Fprintln(rtx.Stdout, {{.HelpVar}})
		rtx.SignalExit(0)
		return
	case flags.Version:
		build := rotini.MustGet[*rotini.Build](rtx, "build")
		fmt.Fprintf(rtx.Stdout, "v%s\n", build.VersionSemantic)
		rtx.SignalExit(0)
		return
	default:
		fmt.Fprintln(rtx.Stdout, {{.HelpVar}})
		rtx.SignalExit(1)
		return
	}
}
