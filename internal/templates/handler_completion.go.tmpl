package {{.Package}}

import (
	"context"
	"fmt"

	"github.com/go-rotini/rotini"
)

type {{.HandlersType}} struct{
	rotini.DefaultCascadingPreRun
	rotini.DefaultPreRun
	rotini.DefaultPostRun
	rotini.DefaultCascadingPostRun
}

var _ rotini.CommandHandlers = (*{{.HandlersType}})(nil)

func (*{{.HandlersType}}) Run(ctx context.Context, rtx *rotini.Context) {
	inputs, err := rotini.Collect[{{.RootCommandName}}CompletionInputs](rtx)
	if err != nil {
		fmt.Fprintf(rtx.Stderr, "Error: %v\n\n", err)
{{- if .HasHelp}}
		fmt.Fprintln(rtx.Stdout, {{.HelpVar}})
{{- end}}
		rtx.SignalExit(rotini.ExitUsage)
		return
	}
{{- if .HasHelp}}

	if inputs.{{.RootCommandName}}Completion.Flags.Help {
		fmt.Fprintln(rtx.Stdout, {{.HelpVar}})
		rtx.SignalExit(0)
		return
	}
{{- end}}

	// The shell arg is enum-constrained in the spec, so an unsupported shell
	// never reaches here — Parse already rejected it.
	script, err := Completion(inputs.{{.RootCommandName}}Completion.Arguments.Shell)
	if err != nil {
		fmt.Fprintln(rtx.Stderr, "Error:", err)
		rtx.SignalExit(1)
		return
	}

	// The `source <({{.Package}} completion zsh)` idiom: the script, stdout, nothing else.
	fmt.Fprintln(rtx.Stdout, script)
}
