{{- /*
help.text.tmpl — rotini's built-in command-help template.

Rendered once per command. Available data (see internal/help.go, helpData):

  .Root      string    root/binary name
  .Name      string    this command's name ("" for the root)
  .Path      string    space-joined command path from the root ("" for the root)
  .Short     string    short_description
  .Long      string    long_description
  .Intro     string    Long (or Short) — the default header block
  .Usage     string    resolved usage line(s) (override or auto-derived), un-indented
  .Examples  []string  example invocation lines
  .Arguments []HelpRow {.Left, .Right}: argument name + description
  .Flags     []HelpRow {.Left, .Right}: "-x,--xxx" + description
  .Commands  []HelpRow {.Left, .Right}: "name;alias" + short description
  .Footer    string    the "Use … help <command>" line ("" when no sub-commands)
  .ArgWidth / .FlagWidth / .CmdWidth  int  left-column widths, for alignment

Helpers:
  {{indent N s}}          indent every line of s by N spaces
  {{row .Left .Right W}}  render an aligned "  left    right" row (no right → bare left)

Sections are separated by one blank line; trailing whitespace/newlines are
trimmed after rendering.
*/ -}}
{{- if .Intro}}{{.Intro}}

{{end -}}
Usage:
{{indent 2 .Usage -}}
{{- if .Arguments}}

Arguments:
{{- range .Arguments}}
{{row .Left .Right $.ArgWidth}}
{{- end}}
{{- end}}
{{- if .Flags}}

Flags:
{{- range .Flags}}
{{row .Left .Right $.FlagWidth}}
{{- end}}
{{- end}}
{{- if .Commands}}

Commands:
{{- range .Commands}}
{{row .Left .Right $.CmdWidth}}
{{- end}}
{{- end}}
{{- if .Examples}}

Examples:
{{- range .Examples}}
  {{.}}
{{- end}}
{{- end}}
{{- if .Footer}}

{{.Footer}}
{{- end}}
