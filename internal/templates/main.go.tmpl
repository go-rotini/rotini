//go:generate go tool rotini generate ./.rotini.spec.yaml --config ./.rotini.conf.yaml
package main

import (
	{{.PackageAlias}} "{{.Package}}"
	"github.com/go-rotini/rotini"
)

var (
	version = "dev"
	commit  = "none"
	date    = "unknown"
)

func main() {
	{{.PackageAlias}}.Program.
		Bind("parser", rotini.NewParser()).
		Bind("suggestor", rotini.NewSuggestor()).
		Bind("build", rotini.BuildInfo(version)).
		Bind("commit", commit).
		Bind("date", date).
		Execute()
}
