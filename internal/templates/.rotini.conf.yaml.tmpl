$schema: https://raw.githubusercontent.com/go-rotini/rotini/refs/tags/{{.RotiniVersion}}/schema-conf.json
generate:
  cmd:
    package: cmd/{{.RootCommandName}}/rth
    gen_file: handlers.go
    prune:
      enabled: true
  framework:
    package: cmd/{{.RootCommandName}}/rtg
    gen_file: rotini.go
    additional_imports: []
