$schema: https://raw.githubusercontent.com/go-rotini/rotini/refs/tags/{{.Version}}/schema-conf.json
initialize:
  package: cmd
  format: yaml
generate:
  packages:
    entrypoint:
      package: cmd/{{.Package}}
      file: main.go
    cmd:
      package: internal/cmd/{{.Package}}
      file: zz_rotini.gen.go
    cmdgen:
      package: internal/cmd/{{.Package}}
      file: zz_rotini.gen.go
  features:
    help:
      enabled: true
      dir: internal/cmd/{{.Package}}/embed
    man:
      enabled: false
      dir: internal/cmd/{{.Package}}/embed
    completion:
      enabled: false
      dir: internal/cmd/{{.Package}}/embed
validate:
  fail: collect
