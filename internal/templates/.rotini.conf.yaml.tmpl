$schema: https://raw.githubusercontent.com/go-rotini/rotini/refs/tags/{{.Version}}/schema-conf.json
generate:
  packages:
    entrypoint:
      package: cmd/{{.Package}}
      file: main.go
    cmd:
      package: internal/cmd/{{.Package}}
      file: zz_rotini.gen.go
    cmdgen:
      package: internal/cmd/{{.Package}}
      file: zz_rotini.gen.go
  features:
    help:
      enabled: {{if .WithHelp}}true{{else}}false{{end}}
      embed: false
      embed_dir: internal/cmd/{{.Package}}/renders
      template_dir: internal/cmd/{{.Package}}/templates
    completion:
      enabled: {{if .WithCompletion}}true{{else}}false{{end}}
      embed: false
      embed_dir: internal/cmd/{{.Package}}/renders
      template_dir: internal/cmd/{{.Package}}/templates
    man:
      enabled: {{if .WithMan}}true{{else}}false{{end}}
      embed: true
      embed_dir: internal/cmd/{{.Package}}/renders
      template: true
      template_dir: internal/cmd/{{.Package}}/templates
    markdown:
      enabled: {{if .WithMarkdown}}true{{else}}false{{end}}
      embed: true
      embed_dir: internal/cmd/{{.Package}}/renders
      template: true
      template_dir: internal/cmd/{{.Package}}/templates
validate:
  fail: collect
