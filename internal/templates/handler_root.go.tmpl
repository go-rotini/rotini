package {{.Package}}

import (
	"context"
	"errors"
	"fmt"

	"github.com/go-rotini/rotini"
)

type {{.HandlersType}} struct{
	rotini.DefaultCascadingPreRun
	rotini.DefaultPreRun
	rotini.DefaultPostRun
	rotini.DefaultCascadingPostRun
}

var _ rotini.CommandHandlers = (*{{.HandlersType}})(nil)

func (*{{.HandlersType}}) Run(ctx context.Context, rtx *rotini.Context) {
	inputs, err := rotini.Collect[{{.RootCommandName}}Inputs](rtx)
	if err != nil {
		msg := err.Error()
		var parseErr *rotini.ParseError
		if errors.As(err, &parseErr) && parseErr.Token != "" {
			if suggestor, ok := rotini.Get[*rotini.Suggestor](rtx, rotini.KeySuggestor); ok {
				if hits := suggestor.Suggest(parseErr.Token, parseErr.Candidates); len(hits) > 0 {
					msg += fmt.Sprintf("\n\nDid you mean %q?", hits[0])
				}
			}
		}
		fmt.Fprintf(rtx.Stderr, "Error: %s\n\n", msg)
{{- if .HasHelp}}
		fmt.Fprintln(rtx.Stdout, {{.HelpVar}})
{{- end}}
		rtx.SignalExit(1)
		return
	}

	flags := inputs.{{.RootCommandName}}.Flags
	switch {
{{- if .HasHelp}}
	case flags.Help:
		fmt.Fprintln(rtx.Stdout, {{.HelpVar}})
		rtx.SignalExit(0)
		return
{{- end}}
{{- if .HasVersion}}
	case flags.Version:
		v := rotini.MustGet[*rotini.Versioner](rtx, rotini.KeyVersioner)
		fmt.Fprintf(rtx.Stdout, "v%s\n", v.VersionSemantic)
		rtx.SignalExit(0)
		return
{{- end}}
	default:
{{- if .HasHelp}}
		fmt.Fprintln(rtx.Stdout, {{.HelpVar}})
{{- else}}
		fmt.Fprintln(rtx.Stderr, "Error: no input provided")
{{- end}}
		rtx.SignalExit(1)
		return
	}
}
