package {{.Package}}

import (
	"context"
	"fmt"

	"github.com/go-rotini/rotini"
)

type {{.HandlersType}} struct{
	rotini.DefaultCascadingPreRun
	rotini.DefaultPreRun
	rotini.DefaultPostRun
	rotini.DefaultCascadingPostRun
}

var _ rotini.CommandHandlers = (*{{.HandlersType}})(nil)

func (*{{.HandlersType}}) Run(ctx context.Context, rtx *rotini.Context) {
	inputs, err := rotini.Collect[{{.RootCommandName}}Inputs](rtx)
	if err != nil {
		// Record the error and stop: the program's OnError funnel reports it
		// (rotini's default prints it and exits by category). To report it your
		// own way — a "did you mean" from the bound Suggestor, a help dump, a
		// logger — set Program.WithOnErrorFn; nothing is printed here.
		rtx.RecordError(err)
		rtx.SignalExit(1)
		return
	}

	flags := inputs.{{.RootCommandName}}.Flags
	switch {
{{- if .HasHelp}}
	case flags.Help:
		fmt.Fprintln(rtx.Stdout, {{.HelpVar}})
		rtx.SignalExit(0)
		return
{{- end}}
{{- if .HasVersion}}
	case flags.Version:
		v := rotini.MustGet[*rotini.Versioner](rtx, rotini.KeyVersioner)
		fmt.Fprintf(rtx.Stdout, "v%s\n", v.VersionSemantic)
		rtx.SignalExit(0)
		return
{{- end}}
	default:
{{- if .HasHelp}}
		fmt.Fprintln(rtx.Stdout, {{.HelpVar}})
{{- else}}
		fmt.Fprintln(rtx.Stderr, "Error: no input provided")
{{- end}}
		rtx.SignalExit(1)
		return
	}
}
