{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Region": {
      "enum": [
        "eu",
        "us"
      ],
      "type": "string"
    }
  },
  "description": ".ops-team.yaml in the working directory or the nearest parent holding one, read by ops deploy and its sub-commands.",
  "properties": {
    "defaults": {
      "properties": {
        "region": {
          "$ref": "#/definitions/Region",
          "default": "eu",
          "description": "The region commands use when none is given.",
          "enum": [
            "eu",
            "us"
          ]
        }
      },
      "type": "object"
    },
    "deploy": {
      "properties": {
        "replicas": {
          "description": "how many copies",
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "net": {
      "properties": {
        "retries": {
          "description": "how often to retry",
          "maximum": 9,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "token": {
      "deprecated": true,
      "deprecationMessage": "deprecated since 1.2.0: use auth.token",
      "description": "the API token",
      "type": "string"
    },
    "ui": {
      "properties": {
        "color": {
          "default": "auto",
          "description": "when to color",
          "enum": [
            "auto",
            "always",
            "never",
            "tty"
          ],
          "enumDescriptions": [
            "color on a terminal",
            "",
            "",
            "same as auto"
          ],
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "title": "ops configuration file \"team\"",
  "type": "object"
}
