## The environment variables cfgctl reads.
## Each line starting with "# " is a variable: remove the "# " to set it.

## how many instances (int; default 1; read by cfgctl deploy, cfgctl doctor, cfgctl show)
# CFGCTL_DEPLOY_REPLICAS=1

## HTTP tuning, as a family of variables (map[string]any); one variable per key
# CFGCTL_HTTP__<KEY>=

## the configuration profile to use (string; also read as CFGCTL_STAGE)
# CFGCTL_PROFILE=

## deployment region (string; default us-east-1; read by cfgctl deploy, cfgctl doctor)
# CFGCTL_REGION=us-east-1

## a token read from an exactly-named variable (string; secret)
# DEPLOY_TOKEN=

## a secret, to prove provenance redacts it (string; secret)
# DOCTOR_TOKEN=

## token for the registry (string; secret)
# GITHUB_TOKEN=
