# Codex rules generated by rotini from the commands' effects. Copy this file to
# ~/.codex/rules/ (or a project's .codex/rules/).

prefix_rule(
    pattern = ["taskr", ["list", "ls"]],
    decision = "allow",
    justification = "list tasks (read-only)",
    match = ["taskr list"],
    not_match = ["taskr"],
)

prefix_rule(
    pattern = ["taskr", "purge"],
    decision = "prompt",
    justification = "delete finished tasks (destructive)",
    match = ["taskr purge"],
    not_match = ["taskr"],
)

prefix_rule(
    pattern = ["taskr", "remote", "sync"],
    decision = "prompt",
    justification = "sync with the server (destructive with --prune)",
    match = ["taskr remote sync"],
    not_match = ["taskr remote"],
)

prefix_rule(
    pattern = ["taskr", "remote", "show"],
    decision = "allow",
    justification = "show the server's address (read-only)",
    match = ["taskr remote show"],
    not_match = ["taskr remote"],
)
