.TH "OPS\-ENVIRONMENT" 1 "" "ops" "Miscellaneous"
.SH NAME
ops\-environment \- the environment variables ops reads
.SH ENVIRONMENT
.TP
\fBOPS_DEPLOY_REPLICAS\fR \fIint\fR
how many to run (default 1, used by: ops deploy)
.TP
\fBOPS_LOG\fR \fIstring\fR
the log level (used by: ops)
.TP
\fBOPS_TOKEN\fR \fIstring\fR
the API token (used by: ops)
.SH "SEE ALSO"
\fBops\fR(1)
