package {{.Package}}

import (
	"context"
	"fmt"
	"time"

	"github.com/go-rotini/rotini"
)

var _ rotini.ErrorHandler = (*{{.Handler}})(nil)

type {{.Handler}} struct {
	rotini.NoCascadingPreRunE
	rotini.NoPreRunE
	rotini.NoCascadingPostRunE
}

func (*{{.Handler}}) Run(ctx context.Context, rtx *rotini.Context) error {
	inputs, err := rtx.Inputs[{{.Inputs}}]()
	if err != nil {
		return err
	}
	flags := inputs.{{.Frame}}.Flags

	if flags.For > 0 {
		var cancel context.CancelFunc
		ctx, cancel = context.WithTimeout(ctx, flags.For)
		defer cancel()
	}

	ticker := time.NewTicker(flags.Interval)
	defer ticker.Stop()
	for {
		select {
		case <-ctx.Done():
			return nil
		case now := <-ticker.C:
			if _, err := fmt.Fprintln(rtx.Stdout, "working at", now.Format(time.RFC3339)); err != nil {
				return err
			}
		}
	}
}

func (*{{.Handler}}) PostRun(ctx context.Context, rtx *rotini.Context) error {
	_, err := fmt.Fprintln(rtx.Stderr, "{{.Name}} serve: stopped")
	return err
}
