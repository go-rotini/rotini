package {{.Package}}

import (
	"context"
	"fmt"

	{{.RuntimeImport}}
)

var _ rotini.Handlers = (*{{.HandlersType}})(nil)

// {{.HandlersType}} implements `{{.Invocation}}`.
//
// The embedded types are no-op implementations of the hooks this command does not use, so
// only Run is written below. Implement one by declaring a method with the same name:
// CascadingPreRun and CascadingPostRun run for every command in the chain, PreRun, Run and
// PostRun only for this one.
type {{.HandlersType}} struct {
	rotini.DefaultCascadingPreRun
	rotini.DefaultPreRun
	rotini.DefaultPostRun
	rotini.DefaultCascadingPostRun
}

// Run performs `{{.Invocation}}`.
//
// Collect reconciles every input channel the spec declares for this command into the
// generated {{.InputsType}}, validated, in the documented precedence. A handler does not print
// its own errors: it records them, and the runtime reports them once, after teardown.
//
// This file was created once and is now yours — rotini never overwrites it. Delete anything
// below you do not want.
func (*{{.HandlersType}}) Run(ctx context.Context, rtx *rotini.Context) {
{{- if .AnswerBeforeCollect}}
	// Answered BEFORE Collect, from argv alone.
	//
	// ParseArgv reads the command line with no defaults, no fallback and — the point here —
	// no required or enum validation. Collect validates, so asking it first means
	// `{{.Invocation}} --{{.HelpFlagName}}` reports a missing argument instead of printing the page:
	// the user asked NOT to run the command, and was told off for not supplying what
	// running it would need.
	if argv, err := rotini.ParseArgv[{{.InputsType}}](rtx); err == nil {
{{- if .HelpFlag}}
		if argv.Values.{{.Prefix}}.Flags.{{.HelpFlag}} {
			fmt.Fprintln(rtx.Stdout, {{.HelpVar}})
			rtx.HaltWithCode(0)
			return
		}
{{- end}}
{{- if .VersionFlag}}
		// The entrypoint sets this with rotini.Program.WithVersion, from whatever the
		// binary was built with.
		if argv.Values.{{.Prefix}}.Flags.{{.VersionFlag}} {
			fmt.Fprintln(rtx.Stdout, rtx.Version())
			rtx.HaltWithCode(0)
			return
		}
{{- end}}
	}
{{- end}}
{{- if .NeedsInputs}}

	{{if .UsesInputs}}inputs, err{{else}}_, err{{end}} := rotini.Collect[{{.InputsType}}](rtx)
	if err != nil {
		// HaltWith records the error and stops the run as one act, claiming no exit code —
		// the funnel decides what an input failure costs. It is the correct spelling in
		// every hook, so failing never has to be written differently depending on which
		// hook you are in. To record a problem and CONTINUE instead, use rtx.RecordError.
		rtx.HaltWith(err)
		return
	}
{{- end}}
{{- if .HelpPathArg}}

	// Resolve the generated help page for the requested command path; no path is the
	// root's own page.
	page, err := Help(inputs.{{.Prefix}}.Arguments.{{.HelpPathArg}}...)
	if err != nil {
		rtx.HaltWith(err)
		return
	}
	fmt.Fprintln(rtx.Stdout, page)
{{- else if .VersionOnly}}

	fmt.Fprintln(rtx.Stdout, rtx.Version())
{{- else if .PrintHelpWhenBare}}

	// Nothing to do yet: show this command's own help rather than an empty run.
	// HaltWithCode here, not Halt: "invoked with no sub-command" is a deliberate non-zero
	// verdict, so the code is the point rather than an artifact of stopping.
	fmt.Fprintln(rtx.Stdout, {{.HelpVar}})
	rtx.HaltWithCode(1)
{{- else}}

	// TODO: replace this with the command's work.
	fmt.Fprintf(rtx.Stdout, "%s: %+v\n", "{{.Invocation}}", inputs)
{{- end}}
}
