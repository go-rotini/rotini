package {{.Package}}

import (
	"context"
	"fmt"

	{{.RuntimeImport}}
)

var _ rotini.Handlers = (*{{.HandlersType}})(nil)

type {{.HandlersType}} struct {
	rotini.DefaultCascadingPreRun
	rotini.DefaultPreRun
	rotini.DefaultPostRun
	rotini.DefaultCascadingPostRun
}

func (*{{.HandlersType}}) Run(ctx context.Context, rtx *rotini.Context) {
{{- if and .HelpFlag .VersionFlag}}
	if argv, err := rotini.ParseArgv[{{.InputsType}}](rtx); err == nil {
		if argv.Values.{{.HelpFrame}}.Flags.{{.HelpFlag}} {
			fmt.Fprintln(rtx.Stdout, rtx.Help())
			rtx.HaltWithCode(0)
			return
		}

		if argv.Values.{{.Prefix}}.Flags.{{.VersionFlag}} {
			version := rtx.Version()
			if version == "" {
				version = "unknown"
			}

			fmt.Fprintln(rtx.Stdout, version)
			rtx.HaltWithCode(0)
			return
		}
	}
{{else if .HelpFlag}}
	if argv, err := rotini.ParseArgv[{{.InputsType}}](rtx); err == nil && argv.Values.{{.HelpFrame}}.Flags.{{.HelpFlag}} {
		fmt.Fprintln(rtx.Stdout, rtx.Help())
		rtx.HaltWithCode(0)
		return
	}
{{else if .VersionFlag}}
	if argv, err := rotini.ParseArgv[{{.InputsType}}](rtx); err == nil && argv.Values.{{.Prefix}}.Flags.{{.VersionFlag}} {
		version := rtx.Version()
		if version == "" {
			version = "unknown"
		}

		fmt.Fprintln(rtx.Stdout, version)
		rtx.HaltWithCode(0)
		return
	}
{{end}}
{{- if .NeedsInputs}}
{{- if .UsesInputs}}
	inputs, err := rotini.Collect[{{.InputsType}}](rtx)
	if err != nil {
		rtx.HaltWith(err)
		return
	}
{{else}}
	if _, err := rotini.Collect[{{.InputsType}}](rtx); err != nil {
		rtx.HaltWith(err)
		return
	}
{{end}}
{{- end}}
{{- if .HelpPathArg}}
	page, err := Help(inputs.{{.Prefix}}.Arguments.{{.HelpPathArg}}...)
	if err != nil {
		rtx.HaltWith(err)
		return
	}

	fmt.Fprintln(rtx.Stdout, page)
{{- else if .VersionOnly}}
	version := rtx.Version()
	if version == "" {
		version = "unknown"
	}

	fmt.Fprintln(rtx.Stdout, version)
{{- else if .PrintHelpWhenBare}}
	fmt.Fprintln(rtx.Stdout, rtx.Help())
	rtx.HaltWithCode(1)
{{- else}}
	fmt.Fprintf(rtx.Stdout, "%s: %+v\n", "{{.Invocation}}", inputs)
{{- end}}
}
