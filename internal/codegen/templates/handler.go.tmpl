package {{.Package}}

import (
	"context"
	"fmt"
{{- if and .RootHook .RootHelpFlag}}
	"strings"
{{- end}}

	{{.RuntimeImport}}
)

var _ rotini.Handler = (*{{.HandlerType}})(nil)

type {{.HandlerType}} struct {
{{- if not .RootHook}}
	rotini.NoCascadingPreRun
{{- end}}
	rotini.NoPreRun
	rotini.NoPostRun
	rotini.NoCascadingPostRun
}
{{- if .RootHook}}

func (*{{.HandlerType}}) CascadingPreRun(ctx context.Context, rtx *rotini.Context) {
	inputs, err := rtx.Inputs[{{.InputsType}}]()
	if err != nil {
		rtx.HaltWith(err)
		return
	}
{{- if .RootHelpFlag}}

	if inputs.{{.Prefix}}.Flags.{{.RootHelpFlag}} {
		var path []string
		for _, c := range rtx.CommandChain()[len(strings.Fields(rtx.CommandPath())):] {
			path = append(path, c.Name)
		}

		page, err := Help(path...)
		if err != nil {
			rtx.HaltWith(err)
			return
		}

		if _, err := fmt.Fprintln(rtx.Stdout, page); err != nil {
			rtx.HaltWith(err)
			return
		}

		rtx.HaltWithCode(0)
		return
	}
{{- end}}
{{- if .RootVersionFlag}}

	if inputs.{{.Prefix}}.Flags.{{.RootVersionFlag}} {
		version := rtx.Version()
		if version == "" {
			version = "unknown"
		}
{{if .NewShape}}
		if _, err := fmt.Fprintln(rtx.Stdout, rtx.CommandChain()[0].Name, version); err != nil {
{{- else}}
		if _, err := fmt.Fprintln(rtx.Stdout, version); err != nil {
{{- end}}
			rtx.HaltWith(err)
			return
		}

		rtx.HaltWithCode(0)
		return
	}
{{- end}}
}
{{- end}}

func (*{{.HandlerType}}) Run(ctx context.Context, rtx *rotini.Context) {
{{- if and .HelpFlag .VersionFlag}}
	if argv, err := rtx.ArgvInputs[{{.InputsType}}](); err == nil {
		if argv.Values.{{.HelpFrame}}.Flags.{{.HelpFlag}} {
			if _, err := fmt.Fprintln(rtx.Stdout, rtx.Help()); err != nil {
				rtx.HaltWith(err)
				return
			}

			rtx.HaltWithCode(0)
			return
		}

		if argv.Values.{{.Prefix}}.Flags.{{.VersionFlag}} {
			version := rtx.Version()
			if version == "" {
				version = "unknown"
			}
{{if .NewShape}}
			if _, err := fmt.Fprintln(rtx.Stdout, rtx.CommandChain()[0].Name, version); err != nil {
{{- else}}
			if _, err := fmt.Fprintln(rtx.Stdout, version); err != nil {
{{- end}}
				rtx.HaltWith(err)
				return
			}

			rtx.HaltWithCode(0)
			return
		}
	}
{{else if .HelpFlag}}
	if argv, err := rtx.ArgvInputs[{{.InputsType}}](); err == nil && argv.Values.{{.HelpFrame}}.Flags.{{.HelpFlag}} {
		if _, err := fmt.Fprintln(rtx.Stdout, rtx.Help()); err != nil {
			rtx.HaltWith(err)
			return
		}

		rtx.HaltWithCode(0)
		return
	}
{{else if .VersionFlag}}
	if argv, err := rtx.ArgvInputs[{{.InputsType}}](); err == nil && argv.Values.{{.Prefix}}.Flags.{{.VersionFlag}} {
		version := rtx.Version()
		if version == "" {
			version = "unknown"
		}
{{if .NewShape}}
		if _, err := fmt.Fprintln(rtx.Stdout, rtx.CommandChain()[0].Name, version); err != nil {
{{- else}}
		if _, err := fmt.Fprintln(rtx.Stdout, version); err != nil {
{{- end}}
			rtx.HaltWith(err)
			return
		}

		rtx.HaltWithCode(0)
		return
	}
{{end}}
{{- if .NeedsInputs}}
{{- if .UsesInputs}}
	inputs, err := rtx.Inputs[{{.InputsType}}]()
	if err != nil {
		rtx.HaltWith(err)
		return
	}
{{else}}
	if _, err := rtx.Inputs[{{.InputsType}}](); err != nil {
		rtx.HaltWith(err)
		return
	}
{{end}}
{{- end}}
{{- if .HelpPathArg}}
	page, err := Help(inputs.{{.Prefix}}.Arguments.{{.HelpPathArg}}...)
	if err != nil {
		rtx.HaltWith(err)
		return
	}

	if _, err := fmt.Fprintln(rtx.Stdout, page); err != nil {
		rtx.HaltWith(err)
	}
{{- else if .CompletionArg}}
	script, err := {{.CompletionFunc}}(inputs.{{.Prefix}}.Arguments.{{.CompletionArg}})
	if err != nil {
		rtx.HaltWith(err)
		return
	}

	if _, err := fmt.Fprint(rtx.Stdout, script); err != nil {
		rtx.HaltWith(err)
	}
{{- else if .VersionOnly}}
	version := rtx.Version()
	if version == "" {
		version = "unknown"
	}
{{if .NewShape}}
	if _, err := fmt.Fprintln(rtx.Stdout, rtx.CommandChain()[0].Name, version); err != nil {
{{- else}}
	if _, err := fmt.Fprintln(rtx.Stdout, version); err != nil {
{{- end}}
		rtx.HaltWith(err)
	}
{{- else if and .PrintHelpWhenBare .NewShape}}
	fmt.Fprintln(rtx.Stderr, rtx.Help())
	rtx.HaltWithCode(1)
{{- else if .PrintHelpWhenBare}}
	if _, err := fmt.Fprintln(rtx.Stdout, rtx.Help()); err != nil {
		rtx.HaltWith(err)
		return
	}

	rtx.HaltWithCode(1)
{{- else if .Redact}}
	if _, err := fmt.Fprintln(rtx.Stdout, "{{.Invocation}}"); err != nil {
		rtx.HaltWith(err)
	}
{{- else}}
	if _, err := fmt.Fprintf(rtx.Stdout, "%s: %+v\n", "{{.Invocation}}", inputs); err != nil {
		rtx.HaltWith(err)
	}
{{- end}}
}
