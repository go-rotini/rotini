$schema: ./.rotini-schema.spec.json
version: {{.Version}}
command:
  name: {{.Package}}
  summary: what {{.Package}} does, in one line (replace this)
  description: Describe {{.Package}} here; this paragraph opens {{.Package}} --help.
  footer: Use "{{.Package}} help <command>" for more information about a command.
  flags:
    - name: help
      identifiers: [-h, --help]
      summary: print help
      cascading: true
      short_circuit: true
      schema: { type: bool }
    - name: version
      identifiers: [--version]
      summary: print version
      cascading: true
      short_circuit: true
      schema: { type: bool }
  commands:
    - name: help
      summary: print help
      description: Print help for a command.
      arguments:
        - name: command
          summary: the command path to print help for
          schema: { type: '[]string', complete: { kind: command } }
    - name: version
      summary: print version
      description: Print the {{.Package}} version.
