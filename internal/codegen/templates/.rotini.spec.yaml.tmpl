$schema: ./.rotini-schema.spec.json
version: {{.Version}}
command:
  name: {{.Package}}
  summary: TODO — what {{.Package}} does, in one line
  description: TODO — the paragraph at the top of `{{.Package}} --help`
  footer: Use "{{.Package}} help <command>" for more information about a command.
  flags:
    - name: help
      summary: print help
      identifiers: [-h, --help]
      cascading: true
      short_circuit: true
      schema: { type: bool }
    - name: version
      summary: print version
      identifiers: [-v, --version]
      short_circuit: true
      schema: { type: bool }
  commands:
    - name: help
      summary: print help
      description: Print help for a command.
      arguments:
        - name: command
          summary: the command path to print help for
          schema: { type: '[]string' }
    - name: version
      summary: print version
      description: Print the {{.Package}} version.
