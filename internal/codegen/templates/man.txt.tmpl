{{with .Description}}{{roffBlock .}}
{{end}}{{range .Commands}}.TP
\fB{{roff .Name}}\fR{{range .Aliases}}, \fB{{roff .}}\fR{{end}}
{{roff .Summary}}{{with .Deprecated}} (deprecated: {{roff .}}){{end}}
{{end}}{{end}}
{{with .Arguments}}.SH ARGUMENTS
{{range .}}.TP
\fI{{if .Required}}<{{roff .Name}}{{if .Variadic}}...{{end}}>{{else}}[{{roff .Name}}{{if .Variadic}}...{{end}}]{{end}}\fR
{{roff .Summary}}{{with .Default}} (default {{roff .}}){{end}}{{with .Constraints}} ({{roff .}}){{end}}{{with .Enum}} [{{roff (join . "|")}}]{{end}}{{with .Deprecated}} (deprecated: {{roff .}}){{end}}
{{template "rules" .}}{{end}}{{end}}
{{range .FlagGroups}}.SH {{roffArg (upper (default "Options" .Title))}}
{{with .Description}}{{roffBlock .}}
{{end}}{{range .Flags}}{{template "flag" .}}{{end}}{{end}}
{{with .Cascading}}.SH "GLOBAL OPTIONS"
{{range .}}{{template "flag" .}}{{end}}{{end}}
{{with .Environment}}.SH ENVIRONMENT
{{range .}}.TP
\fB{{roff .Var}}\fR{{with .Type}} \fI{{roff .}}\fR{{end}}
{{roff .Summary}}{{template "notes" .}}
{{template "rules" .}}{{end}}{{end}}
{{with .Configuration}}.SH CONFIGURATION
{{range .}}.TP
\fB{{roff .Name}}\fR{{with .Location}} ({{roff .}}){{end}}{{with .Type}} \fI{{roff .}}\fR{{end}}
{{roff .Summary}}{{template "notes" .}}
{{template "rules" .}}{{end}}{{end}}
{{with .Stdin}}.SH STDIN
{{with .Description}}{{roffBlock .}}
.PP
{{end}}Reads {{if eq .Format "text" "lines"}}{{if eq .Format "text"}}text{{else}}lines of text{{end}}{{else}}a \fB{{roff .Format}}\fR document{{with .Type}} (\fB{{roff .}}\fR){{end}}{{end}} from standard input.{{if .Required}} Required.{{end}}
{{range .Fields}}.TP
\fB{{roff .Name}}\fR{{with .Type}} \fI{{roff .}}\fR{{end}}
{{roff .Description}}{{if .Required}} (required){{end}}
{{end}}{{end}}
{{with .Output}}.SH OUTPUT
{{with .Description}}{{roffBlock .}}
.PP
{{end}}Writes \fB{{roff .Type}}\fR to standard output.
{{range .Fields}}.TP
\fB{{roff .Name}}\fR{{with .Type}} \fI{{roff .}}\fR{{end}}
{{roff .Description}}{{if .Required}} (required){{end}}
{{end}}{{end}}
