{{end}}{{range .Flags}}{{template "flag" .}}{{end}}{{end}}
{{with .Cascading}}.SH "GLOBAL OPTIONS"
{{range .}}{{template "flag" .}}{{end}}{{end}}
{{with .Environment}}.SH ENVIRONMENT
{{range .}}.TP
\fB{{roff .Var}}\fR{{with .Type}} \fI{{roff .}}\fR{{end}}
{{roff .Summary}}{{with .Commands}} (used by: {{roff (join . ", ")}}){{end}}{{template "notes" .}}
{{template "description" .}}{{template "rules" .}}{{template "values" .}}{{end}}{{end}}
{{with .Configuration}}.SH CONFIGURATION
{{range .}}.TP
\fB{{roff .Name}}\fR{{with .Location}} ({{roff .}}){{end}}{{with .Type}} \fI{{roff .}}\fR{{end}}
{{roff .Summary}}{{template "notes" .}}
