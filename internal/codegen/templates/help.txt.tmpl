{{- /* rotini command-help template. This ONE template renders EVERY command
       (root and sub-commands alike). Sections appear only when the command has
       that data, so the same template yields a rich root page and a terse leaf
       page — don't branch on "is this the root".

       COLUMNS: a single tab separates columns. rotini aligns each contiguous
       block of tabbed lines via tabwriter; blank/heading lines reset alignment,
       so each section aligns independently. After rendering, rotini trims
       trailing whitespace and collapses blank-line runs, and the page ends exactly
       at its last line (no trailing newline) — so you don't have to fight template
       whitespace to get clean output.

       DATA (see helpData):
         .Header .Summary .Description .Footer   strings
         .Invocation     full command path, e.g. "rotini generate"
         .Usage          spec declarative (may be empty)
         .UsageDerived   spec computed (always set)
         .Headings.{Usage,Commands,Arguments,Flags,Environment,Configuration,Cascading,Examples}
                       resolved heading text, colon included (override is verbatim)
         .CommandGroups[] {.Title .Commands[]} — Title "" = default heading
         .Arguments[]     {.Name .Summary .Required .Variadic .Default .Enum .Deprecated}
         .Flags[]         {.Identifiers .Summary .Type .Required .Default .Implicit .Enum .Deprecated}
         .Environment[]   {.Var .Summary .Type .Required .Default .Enum .Deprecated}
         .Configuration[] {.Name .Location .Summary .Type .Required .Default .Enum .Deprecated}
         .Cascading[]     same shape as .Flags — cascading flags inherited from ancestors
         .Examples[]      strings
       HELPERS: join, upper, lower, title, trim, trimPrefix, trimSuffix, replace,
                indent, repeat, default, contains, hasPrefix, hasSuffix, first, last.
                All deterministic (no clock/entropy) to keep rendering byte-stable. */ -}}
{{- with .Header}}{{.}}

{{end -}}
{{- /* Prose: the description, or the summary when there is no description. Without the
       fallback a command declaring only a summary renders a page that never says what it
       does — the summary appears in its PARENT's command list and nowhere on its own page.
       man carries it in NAME and markdown renders it outright; help was the odd one out. */ -}}
{{- $prose := .Description}}{{if not $prose}}{{$prose = .Summary}}{{end -}}
{{- with $prose}}{{.}}

{{end -}}
{{- $usage := .Usage}}{{if not $usage}}{{$usage = .UsageDerived}}{{end -}}
{{- with $usage}}{{$.Headings.Usage}}
{{indent 2 .}}

{{end -}}
{{- range .CommandGroups}}{{if .Title}}{{.Title}}:{{else}}{{$.Headings.Commands}}{{end}}
{{range .Commands}}  {{.Name}}{{with .Aliases}}, {{join . ", "}}{{end}}	{{.Summary}}{{with .Deprecated}} (deprecated: {{.}}){{end}}
{{end}}
{{end -}}
{{- with .Arguments}}{{$.Headings.Arguments}}
{{range .}}  {{if .Required}}<{{.Name}}{{if .Variadic}}...{{end}}>{{else}}[{{.Name}}{{if .Variadic}}...{{end}}]{{end}}	{{.Summary}}{{with .Default}} (default {{.}}){{end}}{{with .Enum}} [{{join . "|"}}]{{end}}{{with .Deprecated}} (deprecated: {{.}}){{end}}
{{end}}
{{end -}}
{{- range .FlagGroups}}{{if .Title}}{{.Title}}:{{else}}{{$.Headings.Flags}}{{end}}
{{range .Flags}}  {{join .Identifiers ", "}}{{with .Type}} {{.}}{{end}}	{{.Summary}}{{if .Required}} (required){{end}}{{with .Default}} (default {{.}}){{end}}{{with .Implicit}} (implicit: {{.}}){{end}}{{with .Enum}} [{{join . "|"}}]{{end}}{{with .Deprecated}} (deprecated: {{.}}){{end}}
{{end}}
{{end -}}
{{- with .Environment}}{{$.Headings.Environment}}
{{range .}}  {{.Var}}{{with .Type}} {{.}}{{end}}	{{.Summary}}{{if .Required}} (required){{end}}{{with .Default}} (default {{.}}){{end}}{{with .Enum}} [{{join . "|"}}]{{end}}{{with .Deprecated}} (deprecated: {{.}}){{end}}
{{end}}
{{end -}}
{{- with .Configuration}}{{$.Headings.Configuration}}
{{range .}}  {{.Name}}{{with .Location}} ({{.}}){{end}}{{with .Type}} {{.}}{{end}}	{{.Summary}}{{if .Required}} (required){{end}}{{with .Default}} (default {{.}}){{end}}{{with .Enum}} [{{join . "|"}}]{{end}}{{with .Deprecated}} (deprecated: {{.}}){{end}}
{{end}}
{{end -}}
{{- with .Cascading}}{{$.Headings.Cascading}}
{{range .}}  {{join .Identifiers ", "}}{{with .Type}} {{.}}{{end}}	{{.Summary}}{{if .Required}} (required){{end}}{{with .Default}} (default {{.}}){{end}}{{with .Implicit}} (implicit: {{.}}){{end}}{{with .Enum}} [{{join . "|"}}]{{end}}{{with .Deprecated}} (deprecated: {{.}}){{end}}
{{end}}
{{end -}}
{{- with .Examples}}{{$.Headings.Examples}}
{{range .}}  {{.}}
{{end}}
{{end -}}
{{- with .Footer}}{{.}}
{{end -}}
