{{- /* rotini command-help template. This ONE template renders EVERY command
       (root and sub-commands alike). Sections appear only when the command has
       that data, so the same template yields a rich root page and a terse leaf
       page — don't branch on "is this the root".

       COLUMNS: a single tab separates columns. rotini aligns each contiguous
       block of tabbed lines via tabwriter; blank/heading lines reset alignment,
       so each section aligns independently. After rendering, rotini trims
       trailing whitespace and collapses blank-line runs, and the page ends exactly
       at its last line (no trailing newline) — so you don't have to fight template
       whitespace to get clean output.

       DATA:
         .Header .Summary .Description .Footer   strings
         .Invocation     full command path, e.g. "rotini generate"
         .Usage          spec declarative (may be empty)
         .UsageDerived   spec computed (always set)
         .Headings.{Usage,Commands,Arguments,Flags,Environment,Configuration,Files,Cascading,Stdin,Output,Examples}
                       resolved heading text, colon included (override is verbatim)
         .Passthrough    the command's name when every word after it is passed through
                         unparsed (flags go before it); "" otherwise
         .CommandGroups[] {.Title .Description .Commands[]} — Title "" = default heading;
                          .Description is the paragraph the command's `groups` gives it
         .FlagGroups[]    {.Title .Description .Flags[]} — the same, for .Flags
         .Arguments[]     {.Name .Summary .Required .Variadic .Default .Enum .EnumValues
                          .Deprecated .Constraints .Rules .Passthrough .Placeholder .Env .ConfigKey} —
                          .Passthrough: the argument and every word after it are passed on as
                          typed; .Placeholder: its declared display name, "" for none; .Env and
                          .ConfigKey as on a flag row
         .Flags[]         {.Identifiers .Label .Summary .Type .Required .Default .Implicit .Enum
                          .EnumValues .Deprecated .Env .ConfigKey .Constraints .Rules} —
                          .Label: the identifiers joined, long-only flags indented to the long column;
                          .Env: the flag's environment variables, in lookup order; .ConfigKey:
                          its config key, set only when the command reads config files. Both
                          are empty for a flag with no fallback. alsoSetBy .Env .ConfigKey "" ""
                          renders them as "also set by ...".
         .Constraints     on argument, flag, env and config rows: the declared bounds, lengths,
                          item counts and repeatability as a short note (1..65535); .Rules: the
                          same as sentences, plus pattern and separator; .Accepts: what a
                          time or integer input accepts beyond its type's default (a layout,
                          relative times, base prefixes)
         .EnumValues      on argument, flag, env and config rows: every value that is not hidden,
                          in declared order, as {.Value .Summary .Aliases .Deprecated
                          .DeprecatedSince .RemovedIn .ReplacedBy .Note}, nil when no value declares
                          more than its spelling (.Enum always holds the values alone, hidden ones
                          left out); listed .Enum .EnumValues leaves out the deprecated ones too,
                          and described .EnumValues says whether any value has a summary
         .DeprecatedSince .RemovedIn   on command, argument, flag, env and config rows: the
                          releases that deprecated the item and will remove it ("" when not
                          planned); deprecation .Deprecated .DeprecatedSince .RemovedIn renders
                          "deprecated since 1.4.0, removed in 2.0.0: <message>"
         .Deprecated      on the page: the command's own deprecation message, ending "; use
                          <replacement> instead" when it declares replaced_by, "" when it is not
                          deprecated; .DeprecatedSince and .RemovedIn as on a row
         .ExitStatus[]    {.Code .Name .Summary .Retryable .Output .DocsURL} — the command's
                          exit_status, else the root's, which is program-wide
         .Environment[]   {.Var .Summary .Type .Required .Default .Enum .EnumValues .Deprecated
                          .Constraints .Rules}
         .Configuration[] {.Key .File .Name .Location .Summary .Type .Required .Default .Enum
                          .EnumValues .Deprecated .Constraints .Rules} — .Key: the key a user
                          writes (deploy.timeout); .File: the one file it is read from, as a user
                          names it (.cfgctl.yaml), "" when any file may set it; .Name and
                          .Location: the input's name and "<file name>.<key>", the spec's words
         .Files[]         {.File .Format .Found .PathFrom .AsEnv .Profiles .Note .Name} — the
                          configuration files the command's inputs are read from, in the order
                          they win; nil when none of its inputs reads one. .File: the path, or
                          the name discovery looks for; .Format: the declared format when the
                          name doesn't say it; .Found: where discovery looks ("" for a path);
                          .PathFrom: the flags and variables that name another path; .AsEnv:
                          read as environment variables; .Profiles {.Under .Select .Default},
                          nil for none; .Note: all of that in one line; .Name: the logical name
         .FlagRules[]     {.Kind .Flags .Condition .Text} — the rules between the command's
                          flags: .Kind is mutually_exclusive, required_together, one_of,
                          at_least_one or dependency; .Flags the flags it names (--json);
                          .Condition when a dependency applies ("with --tls"); .Text the rule as
                          a sentence ("--json and --yaml can't be used together")
         .Cascading[]     same shape as .Flags — cascading flags inherited from ancestors
         .Stdin           {.Format .Type .Description .Required .Stream .NUL .Unless .Fields[]}, nil when the
                          command declares no stdin
         .Output          {.Description .Type .Fields[] .Stream}, nil when
                          the command declares no output; .Fields[] {.Name .Type .Description .Required};
                          .Stream: the command writes a stream of .Type, one item at a time
                          .Tag .Kinds[]: a stream whose items come in several kinds; .Tag names the
                          property saying which, .Kinds[] {.Value .Type .Description .Fields[]}
         .Examples[]      strings: each example's command line
         .ExampleRows[]   {.Run .Summary}: each example's command line and its one-line summary
                          ("" for none)
         .Description     on argument, flag, env and config rows too: the input's longer text,
                          paragraphs separated by blank lines ("" for none). Help shows .Summary
                          only; man and markdown show both
         .Default         on argument, flag, env and config rows: the default as help shows it
                          ("" for none); man and markdown write a list or map default as JSON
         .Stability       on command, argument, flag, env and config rows: "experimental", "beta"
                          or "" (stable), as declared. On the page itself: the command's
                          stability, inherited from its ancestors; stabilityNote .Stability
                          renders the line saying what it promises
         .Effects        on the page: what running the command does, as declared ("destructive,
                          not idempotent, open world"), "" when it declares none; on a flag
                          row: what giving the flag adds ("destructive")
         .Type            on flag, env and config rows: the value's label in the user's
                          words: the placeholder, else string, int, uint, number, bool, a value
                          type (duration, url, ...), file, dir, <label>... for a list, key=<label>
                          for a map, value for a type of the author's own; "" for a flag that
                          takes no value
         .Metadata        on the page and on command, argument, flag, env and config rows: the
                          item's own `metadata` labels, as written (nil for none); the default
                          templates don't show them
         .Page .ParentPage   on command and topic rows, the item's page name (taskr-add); on
                          the page, its parent's page name ("" on the root's)
         .Topics[]        {.Name .Summary .Page} — the help topics, on the root's page only
         .Headings.Topics resolved heading above .Topics
         .Topic           true on a help topic's page (`help <topic>`): .Summary and .Description
                          are the topic's, .Environment holds a generated environment topic's
                          rows, .Files and .Configuration a generated configuration topic's, each
                          row with .Commands (the commands that read it); the rest is empty
       HELPERS: join, upper, lower, title, trim, trimPrefix, trimSuffix, replace,
                indent, repeat, default, contains, hasPrefix, hasSuffix, first, last,
                alsoSetBy, deprecation, stabilityNote, listed, described, notes (the
                non-empty notes in one parenthetical: notes "default 1" "" "1..100" gives
                " (default 1, 1..100)"; false counts as empty, for `and .Required "required"`).
                All deterministic (no clock/entropy) to keep rendering byte-stable. */ -}}
{{- define "values"}}{{if described .EnumValues}}{{range .EnumValues}}{{if not .Deprecated}}  	  {{.Value}}	{{.Summary}}
{{end}}{{end}}{{end}}{{end -}}
{{- define "flag"}}  {{.Label}}{{with .Type}} {{.}}{{end}}	{{.Summary}}{{notes .Effects (and .Required "required") (and .Default (printf "default %s" .Default)) (and .Implicit (printf "implicit: %s" .Implicit)) .Constraints .Accepts .Stability}}{{with listed .Enum .EnumValues}} [{{join . "|"}}]{{end}}{{if .Deprecated}} ({{deprecation .Deprecated .DeprecatedSince .RemovedIn}}){{end}}
{{if or .Env .ConfigKey}}  	{{alsoSetBy .Env .ConfigKey "" ""}}
{{end}}{{template "values" .}}{{end -}}
{{- with .Header}}{{.}}

{{end -}}
{{- /* Prose: the description, or the summary when there is no description, so a command
       that declares only a summary still says what it does on its own page. */ -}}
{{- $prose := .Description}}{{if not $prose}}{{$prose = .Summary}}{{end -}}
{{- with $prose}}{{.}}

{{end -}}
{{- if .Deprecated}}This command is {{deprecation .Deprecated .DeprecatedSince .RemovedIn}}

{{end -}}
{{- with .Stability}}{{stabilityNote .}}

{{end -}}
{{- with .Effects}}Effects: {{.}}

{{end -}}
{{- $usage := .Usage}}{{if not $usage}}{{$usage = .UsageDerived}}{{end -}}
{{- with $usage}}{{$.Headings.Usage}}
{{indent 2 .}}

{{end -}}
{{- with .Passthrough}}Every word after "{{.}}" is passed through as written, so flags go before "{{.}}".

{{end -}}
{{- range .CommandGroups}}{{if .Title}}{{.Title}}:{{else}}{{$.Headings.Commands}}{{end}}
{{with .Description}}{{indent 2 .}}
{{end}}{{range .Commands}}  {{.Name}}{{with .Aliases}}, {{join . ", "}}{{end}}	{{.Summary}}{{with .Stability}} ({{.}}){{end}}{{if .Deprecated}} ({{deprecation .Deprecated .DeprecatedSince .RemovedIn}}){{end}}
{{end}}
{{end -}}
{{- with .Topics}}{{$.Headings.Topics}}
{{range .}}  {{.Name}}	{{.Summary}}
{{end}}
{{end -}}
{{- with .Arguments}}{{$.Headings.Arguments}}
{{range .}}  {{if .Required}}<{{or .Placeholder .Name}}{{if .Variadic}}...{{end}}>{{else}}[{{or .Placeholder .Name}}{{if .Variadic}}...{{end}}]{{end}}	{{.Summary}}{{notes (and .Passthrough "passed through as typed") (and .Default (printf "default %s" .Default)) .Constraints .Accepts .Stability}}{{with listed .Enum .EnumValues}} [{{join . "|"}}]{{end}}{{if .Deprecated}} ({{deprecation .Deprecated .DeprecatedSince .RemovedIn}}){{end}}
{{if or .Env .ConfigKey}}  	{{alsoSetBy .Env .ConfigKey "" ""}}
{{end}}{{template "values" .}}{{end}}
{{end -}}
{{- range $i, $g := .FlagGroups}}{{if $i}}
{{end}}{{if .Title}}{{.Title}}:{{else}}{{$.Headings.Flags}}{{end}}
{{with .Description}}{{indent 2 .}}
{{end}}{{range .Flags}}{{template "flag" .}}{{end}}{{end}}
{{- if .FlagGroups}}{{range .FlagRules}}  {{.Text}}
{{end}}
{{end -}}
{{- with .Environment}}{{$.Headings.Environment}}
{{range .}}  {{.Var}}{{with .Type}} {{.}}{{end}}	{{.Summary}}{{notes (and .Required "required") (and .Default (printf "default %s" .Default)) .Constraints .Accepts .Stability}}{{with listed .Enum .EnumValues}} [{{join . "|"}}]{{end}}{{with .Commands}} (used by: {{join . ", "}}){{end}}{{if .Deprecated}} ({{deprecation .Deprecated .DeprecatedSince .RemovedIn}}){{end}}
{{template "values" .}}{{end}}
{{end -}}
{{- with .Configuration}}{{$.Headings.Configuration}}
{{range .}}  {{.Key}}{{with .Type}} {{.}}{{end}}	{{.Summary}}{{notes (and .File (printf "in %s" .File)) (and .Required "required") (and .Default (printf "default %s" .Default)) .Constraints .Accepts .Stability}}{{with listed .Enum .EnumValues}} [{{join . "|"}}]{{end}}{{with .Commands}} (used by: {{join . ", "}}){{end}}{{if .Deprecated}} ({{deprecation .Deprecated .DeprecatedSince .RemovedIn}}){{end}}
{{template "values" .}}{{end}}
{{end -}}
{{- with .Files}}{{$.Headings.Files}}
{{range .}}  {{.File}}	{{.Note}}
{{end}}
{{end -}}
{{- with .Cascading}}{{$.Headings.Cascading}}
{{range .}}{{template "flag" .}}{{end}}
{{end -}}
{{- with .Stdin}}{{$.Headings.Stdin}}
{{with .Description}}  {{.}}
{{end}}  {{.Format}}{{with .Type}} {{.}}{{end}}{{if .NUL}} (NUL-separated){{end}}{{if .Stream}} (streamed){{end}}{{if .Required}} (required){{end}}{{with .Unless}} (only when no {{.}} is given){{end}}
{{range .Fields}}    {{.Name}}{{with .Type}} {{.}}{{end}}	{{.Description}}{{if .Required}} (required){{end}}
{{end}}
{{end -}}
{{- with .Output}}{{$.Headings.Output}}
{{with .Description}}  {{.}}
{{end}}  {{if .Kinds}}a stream of items, one at a time (JSON: one compact value per line; YAML: one document per item, each starting ---); each item's {{.Tag}} says which kind it is:{{else if .Stream}}a stream of {{.Type}}, one item at a time (JSON: one compact value per line; YAML: one document per item, each starting ---){{else}}{{.Type}}{{end}}
{{range .Fields}}    {{.Name}}{{with .Type}} {{.}}{{end}}	{{.Description}}{{if .Required}} (required){{end}}
{{end}}{{$tag := .Tag}}{{range .Kinds}}  {{$tag}}: {{.Value}}{{with .Type}} ({{.}}){{end}}{{with .Description}}  {{.}}{{end}}
{{range .Fields}}    {{.Name}}{{with .Type}} {{.}}{{end}}	{{.Description}}{{if .Required}} (required){{end}}
{{end}}{{end}}
{{end -}}
{{- with .ExampleRows}}{{$.Headings.Examples}}
{{range .}}{{with .Summary}}{{indent 2 (printf "# %s" .)}}
{{end}}{{indent 2 .Run}}
{{end}}
{{end -}}
{{- with .Footer}}{{.}}
{{end -}}
